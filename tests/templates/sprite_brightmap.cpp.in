struct CachedPatch { GLPatch_t patch{}; GLMipmap_t mip{}; };
static std::map<patch_t *, CachedPatch> gpu;
void *Patch_CreateGL(patch_t *patch) {
    auto &g = gpu[patch]; g.patch.mipmap = &g.mip;
    g.patch.max_s = patch->width / 128.0f; g.patch.max_t = patch->height / 128.0f;
    patch->hardware = &g.patch; return patch->hardware;
}
static int makes;
static void HWR_MakePatch(patch_t *, GLPatch_t *, GLMipmap_t *mip, boolean makebitmap) {
    assert(makebitmap); ++makes;
    // The actual allocator initializes flags, so the loader must mark it AFTER this call.
    mip->flags = TF_TRANSPARENT;
    mip->data = &makes;
}
