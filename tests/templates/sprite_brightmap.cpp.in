// Exercise the renderer's actual first-batch and texture-transition blocks.
static void replayFirst() {
    auto *currentTexture = current_texture;
    auto *currentBrightmap = current_brightmap;
    FBITFIELD currentPolyFlags = PF_Masked;
@@BATCH_FIRST@@
}
int ps_hw_numtextures;
static void replayNext(GLMipmap_t *&currentTexture, GLMipmap_t *&currentBrightmap) {
    auto *nextTexture = current_texture;
    auto *nextBrightmap = current_brightmap;
    boolean changeTexture = false, changeState = false;
@@BATCH_CHANGE@@
    assert(changeState && changeTexture);
@@BATCH_NEXT@@
