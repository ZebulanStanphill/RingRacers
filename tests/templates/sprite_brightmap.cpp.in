void HWR_FreeTexture(patch_t *patch) {
    auto it = gpu.find(patch);
    if (it != gpu.end()) {
        auto texture = g_textures.find(it->second.mip.downloaded);
        if (texture != g_textures.end()) {
            for (auto &unit : g_units) if (unit == &texture->second) unit = nullptr;
            if (g_texDownloaded == texture->first) g_texDownloaded = 0;
            g_textures.erase(texture);
        }
        gpu.erase(it);
    }
    patch->hardware = nullptr;
}
static int rotationCases();
static void resetGPU() {
    for (patch_t *p : {&base, &specific, &fallback, &skinBright, &rotated}) p->hardware = nullptr;
    gpu.clear(); g_textures.clear(); uploads.clear(); binds.clear();
    g_units[0] = g_units[1] = nullptr; g_texDownloaded = 0; nextTexture = 1;
    current_texture = current_brightmap = nullptr; makes = 0;
}
int main(int argc, char **argv) {
    (void)argc; (void)argv;
    hwdriver.pfnSetTexture = DriverTexture;
    base.width = specific.width = fallback.width = skinBright.width = rotated.width = 16;
    base.height = specific.height = fallback.height = skinBright.height = rotated.height = 32;
    definitions[SPR_SYM0] = {2, frames};
    definitions[SPR_UNKN] = {2, frames};
    states[S_UNKNOWN].sprite = SPR_UNKN;
    states[S_UNKNOWN].frame = 0;
    spriteinfo[SPR_SYM0].bright[0] = const_cast<char *>("FRAME");
    spriteinfo[SPR_SYM0].bright[SPRINFO_DEFAULT_PIVOT] = const_cast<char *>("SYMBXXB");
    spriteinfo[SPR_UNKN].bright[SPRINFO_DEFAULT_PIVOT] = const_cast<char *>("FALLBACK");
    lumps = {{"FRAME", &specific}, {"SYMBXXB", &fallback}, {"FALLBACK", &fallback}, {"SKIN", &skinBright}};
    state_t state{}; mobj_t thing{};
    thing.sprite = SPR_SYM0; thing.state = &state;
    for (unsigned frame : {0u, 1u}) {
        thing.frame = frame | FF_TRANS50;
        lookups.clear();
        auto spr = project(&thing);
        auto *software = R_CacheSpriteBrightMap(&spriteinfo[SPR_SYM0], frame);
        assert(spr.gpatch == &base && spr.gbright == software);
        assert(lookups.size() == 2 && lookups[0] == lookups[1]);
        assert(lookups[0] == (frame ? "SYMBXXB" : "FRAME"));
    }
    skin_t skin{};
    skin.sprites[1] = {2, frames};
    skin.sprinfo[1].bright[SPRINFO_DEFAULT_PIVOT] = const_cast<char *>("SKIN");
    thing.skin = &skin; thing.sprite = SPR_PLAY; thing.sprite2 = 1; thing.frame = 1;
    assert(project(&thing).gbright == R_CacheSpriteBrightMap(&skin.sprinfo[1], 1));
    thing.skin = nullptr; thing.sprite = SPR_SYM0; thing.frame = 5;
    assert(project(&thing).gbright == &fallback);
    assert(thing.sprite == SPR_UNKN && thing.frame == 0 && state.sprite == SPR_UNKN);
    thing.sprite = SPR_SYM0; thing.frame = 0;
    assert(project(&thing, &rotated).gbright == nullptr); // No transform metadata: safe fallback.
    assert(project(&thing, &rotated).gpatch == &rotated);
    for (int axis = 0; axis < 2; ++axis) {
        specific.width = axis == 0 ? 17 : 16; specific.height = axis == 1 ? 33 : 32;
        assert(project(&thing).gbright == nullptr);
        precipmobj_t rain{}; rain.sprite = SPR_SYM0; rain.frame = 0;
        assert(projectPrecip(&rain).gbright == nullptr);
    }
    specific.width = 16; specific.height = 32;
    precipmobj_t rain{}; rain.sprite = SPR_SYM0; rain.frame = 0;
    assert(projectPrecip(&rain).gbright == &specific);
    spriteinfo[SPR_SYM0].bright[0] = const_cast<char *>("MISSING");
    assert(project(&thing).gbright == nullptr); // An explicit missing frame name does not use the default.
    spriteinfo[SPR_SYM0].bright[0] = nullptr;
    spriteinfo[SPR_SYM0].bright[SPRINFO_DEFAULT_PIVOT] = nullptr;
    assert(project(&thing).gbright == nullptr);

    // The allocator can retain CPU data while the GPU copy is evicted.
    // This path must mark the upload despite bypassing HWR_MakePatch.
    resetGPU(); currently_batching = false;
    Patch_CreateGL(&specific);
    auto *resident = static_cast<GLPatch_t *>(specific.hardware)->mipmap;
    resident->data = &makes;
    HWR_GetSpriteBrightmap(&specific);
    assert(makes == 0 && uploads.size() == 1 && (resident->flags & TF_BRIGHTMAP));
    assert(g_units[0] == nullptr && g_units[1] == FindTexture(resident->downloaded));

    unsigned cases = 0;
    for (bool batching : {false, true}) for (auto dispatch : {draw, split, precip, linkdraw}) {
        resetGPU(); currently_batching = batching;
        UINT8 colormap[256]{};
        gl_vissprite_t spr{}; spr.gpatch = &base; spr.gbright = &specific; spr.colormap = colormap;
        dispatch(&spr);
        assert(base.hardware && specific.hardware);
        auto *baseMip = static_cast<GLPatch_t *>(base.hardware)->mipmap, *brightMip = static_cast<GLPatch_t *>(specific.hardware)->mipmap;
        assert(makes == 2 && uploads.size() == 2);
        assert(!(uploads[0]->flags & TF_BRIGHTMAP) && (uploads[1]->flags & TF_BRIGHTMAP));
        assert(brightMip->colormap == nullptr && (brightMip->flags & TF_TRANSPARENT));
        if (dispatch != linkdraw) assert(lastColormap == colormap);
        if (batching) {
            assert(current_texture == baseMip && current_brightmap == brightMip);
            replayFirst();
        }
        assert(g_units[0] == FindTexture(baseMip->downloaded));
        assert(g_units[1] == FindTexture(brightMip->downloaded));
        // A purge/rebind must restore the flag even without making/uploading data.
        brightMip->flags &= ~TF_BRIGHTMAP;
        dispatch(&spr);
        assert(brightMip->flags & TF_BRIGHTMAP);
        assert(makes == 2 && uploads.size() == 2);
        if (batching) replayFirst();
        assert(g_units[0] == FindTexture(baseMip->downloaded));
        assert(g_units[1] == FindTexture(brightMip->downloaded));
        // Same base texture, now without a brightmap: batch transitions must rebind
        // base even though only currentBrightmap changed, clearing stale unit 1.
        auto *previousBase = baseMip, *previousBright = brightMip;
        spr.gbright = nullptr; dispatch(&spr);
        if (batching) {
            assert(current_texture == baseMip && current_brightmap == nullptr);
            replayNext(previousBase, previousBright);
            assert(previousBase == baseMip && previousBright == nullptr);
        }
        assert(g_units[0] == FindTexture(baseMip->downloaded) && g_units[1] == nullptr);
        assert(!(baseMip->flags & TF_BRIGHTMAP));
        ++cases;
    }
    resetGPU();
    assert(projectionCases == 13);
    if (rotationCases()) return 1;
    assert(allocations.empty());
    printf("sprite brightmaps: %u projection cases, resident-data upload and %u draw/batch transitions passed\n", projectionCases, cases);
}
static patch_t *makePatch(int w, int h, int left, int top, int pattern) {
    std::vector<UINT16> pixels(w*h);
    for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x) {
        bool opaque = pattern == 0 ? (x > 0 && y > 1 && x < w-2 && (x+2*y)%7 != 0)
                     : pattern == 1 ? ((x*3+y)%5 == 0 || (x == w-1 && y == 0))
                     : pattern == 2 ? (x+y)%3 != 0 : false;
        if (opaque) pixels[y*w+x] = 0xFF00 | (1+(x+13*y)%240);
    }
    return static_cast<patch_t *>(Picture_Convert(PICFMT_FLAT16,pixels.data(),PICFMT_PATCH,
        0,nullptr,w,h,left,top,PICFLAGS_NONE));
}
static int pixelAt(patch_t *p, int x, int y) {
    auto *value = static_cast<UINT8 *>(Picture_GetPatchPixel(p,PICFMT_PATCH,x,y,PICFLAGS_NONE));
    return value ? *value : -1;
}
static bool samePatch(patch_t *a, patch_t *b) {
    if (a->width != b->width || a->height != b->height || a->leftoffset != b->leftoffset || a->topoffset != b->topoffset) return false;
    for (int y=0; y<a->height; ++y) for (int x=0; x<a->width; ++x)
        if (pixelAt(a,x,y) != pixelAt(b,x,y)) return false;
    return true;
}
static unsigned rotationPixels, rotationCount;
static bool verifyBright(patch_t *output, patch_t *owner, patch_t *source, patch_t *bright,
    int angle, int xpivot, int ypivot, bool flip) {
    if (!output || output->width != owner->width || output->height != owner->height
        || output->leftoffset != owner->leftoffset || output->topoffset != owner->topoffset) return false;
    // Independent inverse-coordinate oracle derives origin from the output header,
    // source header and pivot; never reads the implementation's transform metadata.
    int pivotx = flip ? source->width-xpivot : xpivot;
    int left = flip ? source->width-source->leftoffset : source->leftoffset;
    for (bool vertical : {false,true}) for (int y=0; y<output->height; ++y) for (int x=0; x<output->width; ++x) {
        int row = vertical ? output->height-1-y : y;
        int dx = x - owner->leftoffset + left - pivotx;
        int dy = row - owner->topoffset + source->topoffset - ypivot;
        // FixedMul floors each product independently, including negative values.
        auto mul = [](int a, int b) { return static_cast<int>(std::floor(static_cast<double>(a)*b/FRACUNIT)); };
        int sx = static_cast<int>(std::floor(static_cast<double>(mul(dx*FRACUNIT,rollcosang[angle]) + mul(dy*FRACUNIT,rollsinang[angle]) + pivotx*FRACUNIT)/FRACUNIT));
        int sy = static_cast<int>(std::floor(static_cast<double>(-mul(dx*FRACUNIT,rollsinang[angle]) + mul(dy*FRACUNIT,rollcosang[angle]) + ypivot*FRACUNIT)/FRACUNIT));
        int expected = -1;
        if (sx>=0 && sx<source->width && sy>=0 && sy<source->height)
            expected = pixelAt(bright,flip ? source->width-1-sx : sx,sy);
        if (pixelAt(output,x,row) != expected) return false;
        ++rotationPixels;
    }
    return true;
}
static int rotationCases() {
    for (int angle=1; angle<ROTANGLES; ++angle) {
        double a = angle*ROTANGDIFF*3.14159265358979323846/180;
        rollcosang[angle] = static_cast<fixed_t>(std::cos(-a)*FRACUNIT);
        rollsinang[angle] = static_cast<fixed_t>(std::sin(-a)*FRACUNIT);
    }
    definitions[SPR_SYM0] = {2, frames};
    state_t state{}; mobj_t thing{}; thing.sprite = SPR_SYM0; thing.state = &state;
    spriteinfo[SPR_SYM0].bright[0] = const_cast<char *>("ROTATED");
    unsigned bindings = 0, orientations = 0;
    for (int geometry : {0,1}) for (int pivot : {0,1,2}) {
        auto *source = makePatch(geometry ? 9 : 7,geometry ? 6 : 11,geometry ? 7 : 1,geometry ? 9 : -2,0);
        auto *bright = makePatch(source->width,source->height,-13,25,1);
        auto *empty = makePatch(source->width,source->height,8,-4,3);
        lumps["BASE_ROT"] = source;
        auto sourceLump = W_CheckNumForLongName("BASE_ROT");
        frames[0].lumppat[0] = sourceLump;
        lumps["ROTATED"] = bright;
        auto &info = spriteinfo[SPR_SYM0];
        memset(info.available,0,sizeof(info.available));
        int xpivot = source->leftoffset, ypivot = source->height/2;
        if (pivot) {
            int slot = pivot == 1 ? SPRINFO_DEFAULT_PIVOT : 0;
            xpivot = pivot == 1 ? 2 : source->width-2; ypivot = pivot == 1 ? 1 : source->height-3;
            info.available[slot/8] |= 1u << (slot%8);
            info.pivot[slot].x = xpivot; info.pivot[slot].y = ypivot;
        }
        for (bool flip : {false,true}) for (int angle=1; angle<ROTANGLES; ++angle) {
            auto *rot = Patch_GetRotatedSprite(&frames[0],0,0,flip,false,&info,angle);
            assert(rot && rot == Patch_GetRotatedSprite(&frames[0],0,0,flip,false,&info,angle));
            // Snapshot of vanilla rotation verifies unchanged Software/base raster,
            // including its existing opaque-bound/crop behavior.
            rotsprite_t baseline{}; std::vector<void *> baselineSlots(2*ROTANGLES);
            baseline.angles = ROTANGLES; baseline.patches = baselineSlots.data();
            Baseline_DoRotation(&baseline,source,angle,xpivot,ypivot,flip);
            auto *original = static_cast<patch_t *>(baseline.patches[angle+(flip ? ROTANGLES : 0)]);
            assert(samePatch(rot,original)); Patch_Free(original);
            auto vis = project(&thing,rot);
            if (!verifyBright(vis.gbright,rot,source,bright,angle,xpivot,ypivot,flip)) {
                fprintf(stderr,"rotated brightmap oracle rejected %s (geometry %d pivot %d angle %d flip %d)\n",
                    vis.gbright ? "misaligned transform" : "dropped map",geometry,pivot,angle,flip);
                return 1;
            }
            Patch_CreateGL(rot); Patch_CreateGL(vis.gbright);
            for (bool vertical : {false,true}) for (bool horizontal : {false,true}) {
                vis.vflip = vertical; vis.flip = horizontal;
                auto uv = coordinates(&vis);
                auto *baseGPU = static_cast<GLPatch_t *>(rot->hardware);
                auto *brightGPU = static_cast<GLPatch_t *>(vis.gbright->hardware);
                assert(baseGPU->max_s == brightGPU->max_s && baseGPU->max_t == brightGPU->max_t);
                for (int corner=0; corner<4; ++corner) {
                    bool right = corner == 1 || corner == 2;
                    bool top = corner >= 2;
                    assert(uv[corner].s == ((right != horizontal) ? baseGPU->max_s : 0));
                    assert(uv[corner].t == ((top == vertical) ? baseGPU->max_t : 0));
                }
                ++orientations;
            }
            vis.vflip = vis.flip = false;
            auto count = allocations.size();
            assert(vis.gbright == Patch_GetRotatedBrightmap(rot,bright) && allocations.size() == count);
            assert(verifyBright(Patch_GetRotatedBrightmap(rot,empty),rot,source,empty,angle,xpivot,ypivot,flip));
            // A second base with different offsets/pivot shares this brightmap.
            auto *other = makePatch(source->width,source->height,source->width-1,3,2);
            spriteframe_t otherFrame{}; spriteinfo_t otherInfo{};
            lumps["OTHER_ROT"] = other; otherFrame.lumppat[0] = W_CheckNumForLongName("OTHER_ROT");
            otherInfo.available[0] = 1; otherInfo.pivot[0].x = 1; otherInfo.pivot[0].y = source->height-1;
            auto *otherRot = Patch_GetRotatedSprite(&otherFrame,0,0,flip,false,&otherInfo,angle);
            auto *otherCache = otherFrame.rotated[0][0];
            auto *otherBright = Patch_GetRotatedBrightmap(otherRot,bright);
            assert(otherBright != vis.gbright && verifyBright(otherBright,otherRot,other,bright,angle,1,source->height-1,flip));
            Patch_Free(otherRot); Z_Free(otherCache->patches); Z_Free(otherCache); Patch_Free(other);
            assert(Patch_GetRotatedBrightmap(rot,nullptr) == nullptr);
            ++bright->width;
            auto mismatch = project(&thing,rot); assert(mismatch.gpatch == rot && mismatch.gbright == nullptr);
            --bright->width; ++bright->height;
            mismatch = project(&thing,rot); assert(mismatch.gpatch == rot && mismatch.gbright == nullptr);
            --bright->height;
            lumps.erase("ROTATED");
            auto absent = project(&thing,rot); assert(absent.gpatch == rot && absent.gbright == nullptr);
            lumps["ROTATED"] = bright;
            if (angle == 1) for (bool batching : {false,true}) for (auto dispatch : {draw,split,linkdraw}) {
                currently_batching = batching; dispatch(&vis);
                auto *baseMip = static_cast<GLPatch_t *>(rot->hardware)->mipmap;
                auto *brightMip = static_cast<GLPatch_t *>(vis.gbright->hardware)->mipmap;
                if (batching) replayFirst();
                assert(g_units[0] == FindTexture(baseMip->downloaded) && g_units[1] == FindTexture(brightMip->downloaded));
                ++bindings;
            }
            ++rotationCount;
        }
        // Sprite-frame caches aren't owned by source patches. Purge clears users,
        // including horizontally flipped slots, then reconstruct from live source.
        Patch_FreeTag(PU_PATCH_ROTATED);
        for (void *slot : std::vector<void *>(frames[0].rotated[0][0]->patches,
                frames[0].rotated[0][0]->patches+2*ROTANGLES)) assert(!slot);
        auto *rebuilt = Patch_GetRotatedSprite(&frames[0],0,0,false,false,&info,1);
        assert(verifyBright(Patch_GetRotatedBrightmap(rebuilt,bright),rebuilt,source,bright,1,xpivot,ypivot,false));
        // Repeated dynamic source reloads must immediately reclaim companion CPU
        // and GPU allocations, even without a rotated-patch tag purge.
        Z_ChangeTag2(bright, PU_SPRITE, __FILE__, __LINE__);
        Patch_FreeTag(PU_SPRITE);
        assert(rebuilt->brightmaps == nullptr);
        currently_batching = false;
        HWR_GetPatch(rebuilt); // Keep the lazily uploaded base in the steady state.
        size_t steady = allocations.size(), steadyGPU = gpu.size(), steadyTextures = g_textures.size();
        for (int reload=0; reload<24; ++reload) {
            bright = makePatch(source->width,source->height,reload,-reload,1);
            auto *map = Patch_GetRotatedBrightmap(rebuilt,bright);
            assert(verifyBright(map,rebuilt,source,bright,1,xpivot,ypivot,false));
            gl_vissprite_t vis{}; vis.gpatch = rebuilt; vis.gbright = map; draw(&vis);
            Patch_Free(bright);
            assert(allocations.size() == steady && rebuilt->brightmaps == nullptr);
            assert(gpu.size() == steadyGPU && g_textures.size() == steadyTextures);
        }
        Patch_FreeTag(PU_PATCH_ROTATED);
        Z_Free(frames[0].rotated[0][0]->patches); Z_Free(frames[0].rotated[0][0]);
        frames[0].rotated[0][0] = nullptr;
        Patch_Free(empty); Patch_Free(source);
    }
    assert(!rotatedbrightmaps && !invalidatedbrightmaps && gpu.empty());
    printf("rotated brightmaps: %u transforms, %u oracle pixels (both vertical orientations), %u UV orientations, %u draw/batch bindings, 144 source reloads passed\n",rotationCount,rotationPixels,orientations,bindings);
    return 0;
}
