// Track zone ownership/users/tags with production's newest-first iteration.
// Real patch conversion, sampling, rotation, projection and destruction run below.
struct Allocation { void *ptr; INT32 tag; void **user; };
static std::vector<Allocation> allocations;
void *Z_Calloc2(size_t size, INT32 tag, void *user, INT32, const char *, INT32) {
    void *p = calloc(1, size); assert(p);
    allocations.insert(allocations.begin(), {p, tag, static_cast<void **>(user)});
    if (user) *static_cast<void **>(user) = p;
    return p;
}
void *Z_Malloc2(size_t size, INT32 tag, void *user, INT32 align, const char *file, INT32 line) {
    return Z_Calloc2(size,tag,user,align,file,line);
}
void Z_Free2(void *p, const char *, INT32) {
    if (!p) return;
    auto it = std::find_if(allocations.begin(), allocations.end(), [p](const auto &a) { return a.ptr == p; });
    assert(it != allocations.end());
    if (it->user) *it->user = nullptr;
    free(p); allocations.erase(it);
}
void Z_ChangeTag2(void *p, INT32 tag, const char *, INT32) {
    for (auto &a : allocations) if (a.ptr == p) { a.tag = tag; return; }
    assert(false);
}
void Z_SetUser2(void *p, void **user, const char *, INT32) {
    for (auto &a : allocations) if (a.ptr == p) { a.user = user; *user = p; return; }
    assert(false);
}
void Z_IterateTags(INT32 low, INT32 high, boolean (*callback)(void *)) {
    // Save the next zone allocation before callback, as production does.
    size_t i = 0;
    while (i < allocations.size()) {
        auto a = allocations[i];
        void *next = i+1 < allocations.size() ? allocations[i+1].ptr : nullptr;
        if (a.tag >= low && a.tag <= high && callback(a.ptr)) Z_Free(a.ptr);
        if (!next) break;
        auto it = std::find_if(allocations.begin(), allocations.end(), [next](const auto &v) { return v.ptr == next; });
        assert(it != allocations.end()); // A destructor must not free the iterator's next patch.
        i = static_cast<size_t>(it - allocations.begin());
    }
}
void *M_Memcpy(void *d, const void *s, size_t n) { return memcpy(d,s,n); }
void I_Error(const char *, ...) { assert(false); abort(); }
RGBA_t *pMasterPalette = nullptr;
#undef NearestColor
UINT8 NearestColor(INT32, INT32, INT32) { assert(false); return 0; }
patch_t *missingpat = nullptr;
static boolean g_patch_was_freed_this_frame;
static INT32 patch_free_depth;
static patch_t *rotatedbrightmaps, *invalidatedbrightmaps;
static boolean freeingbrightmaps;
fixed_t rollcosang[ROTANGLES], rollsinang[ROTANGLES];
