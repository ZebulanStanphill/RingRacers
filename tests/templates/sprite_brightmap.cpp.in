// Dependency mocks stop at WAD lookup, GPU allocation and color translation.
// Selection, admission, mipmap flags, binding and batch replay come from production.
static patch_t base{}, specific{}, fallback{}, skinBright{}, rotated{};
static std::vector<std::string> lookups;
static std::map<std::string, patch_t *> lumps;
static std::vector<patch_t *> cached;
lumpnum_t W_CheckNumForLongName(const char *name) {
    lookups.emplace_back(name ? name : "");
    auto it = lumps.find(name ? name : "");
    if (it == lumps.end()) return LUMPERROR;
    cached.push_back(it->second); return static_cast<lumpnum_t>(cached.size());
}
void *W_CachePatchNum(lumpnum_t num, INT32 tag) {
    assert(tag == PU_SPRITE);
    if (num == 0) return &base;
    assert(num <= cached.size()); return cached[num-1];
}
