#include <cassert>
#include <cerrno>
#include <cstddef>
#include <cstdio>
#include <cstring>
#include <stdexcept>
#include <vector>
#include <sys/socket.h>
#include <netinet/in.h>

// Deliberately differ from host errno values: exercise the production Winsock aliases.
#ifdef TEST_WINSOCK
#define WSAEWOULDBLOCK 10035
#define WSAEMSGSIZE 10040
#define WSAECONNREFUSED 10061
#define WSAEHOSTUNREACH 10065
#define WSAENETUNREACH 10051
#define WSAETIMEDOUT 10060
static int mock_errno;
#undef h_errno
#define h_errno mock_errno
@@WINSOCK_ERRORS@@
#endif
#define HAVE_IPV6
using SOCKET_TYPE = int;
constexpr int ERRSOCKET = -1, BROADCASTADDR = 3;
union mysockaddr_t { struct sockaddr any; struct sockaddr_in ip4; struct sockaddr_in6 ip6; };
static struct { int remotenode, datalength; char data[8]; } packet, *doomcom = &packet;
static bool nodeconnected[4];
static int nodesocket[4], mysockets[2], myfamily[2];
static mysockaddr_t clientaddress[4], broadcastaddress[2];
static size_t mysocketses = 2, broadcastaddresses = 2;
struct Call { int socket; const sockaddr *address; socklen_t length; };
static std::vector<Call> calls;
static int result, error_code;
static ptrdiff_t mock_sendto(int socket, const char *data, int length, int flags,
    const sockaddr *address, socklen_t size)
{
    assert(data == packet.data && length == packet.datalength && flags == 0);
    calls.push_back({socket, address, size});
    errno = error_code;
    return result;
}
#define sendto mock_sendto
static const char *SOCK_GetNodeAddress(int node) { assert(node == 1); return "peer"; }
struct Fatal { int error; };
static void I_Error(const char *, int node, const char *address, unsigned error, const char *)
{
    assert(node == 1 && !strcmp(address, "peer"));
    throw Fatal{static_cast<int>(error)};
}
@@SEND_TO_ADDR@@
@@SEND@@
static void reset()
{
    calls.clear(); result = 8; error_code = 0;
    packet.remotenode = 1; packet.datalength = 8;
    for (int i = 0; i < 4; ++i) { nodeconnected[i] = true; nodesocket[i] = 7; clientaddress[i].any.sa_family = AF_INET; }
    mysockets[0] = 11; mysockets[1] = 12;
    myfamily[0] = AF_INET; myfamily[1] = AF_INET6;
    broadcastaddress[0].any.sa_family = AF_INET; broadcastaddress[1].any.sa_family = AF_INET6;
}
static bool dropped(int error)
{
    reset(); result = ERRSOCKET; error_code = error;
    try { SOCK_Send(); } catch (const Fatal &fatal) { assert(fatal.error == error); return false; }
    assert(calls.size() == 1 && nodeconnected[1] && nodesocket[1] == 7);
    // A later packet uses the same peer/socket and succeeds without repair.
    result = 8; error_code = 0; SOCK_Send();
    assert(calls.size() == 2 && calls.back().socket == 7);
    return true;
}
int main()
{
#ifdef TEST_NEGATIVE
    // Only unreachable behavior should fail with the pre-fix sender.
    if (!dropped(EHOSTUNREACH)) { puts("pre-fix sender fatally rejected unreachable UDP packet"); return 1; }
    return 0;
#else
#ifdef TEST_WINSOCK
    static_assert(EHOSTUNREACH == 10065 && ENETUNREACH == 10051);
#endif
    assert(dropped(EWOULDBLOCK)); assert(dropped(ECONNREFUSED));
    assert(dropped(EHOSTUNREACH)); assert(dropped(ENETUNREACH));
    reset(); SOCK_Send();
    assert(calls.size() == 1 && calls[0].socket == 7 && calls[0].address == &clientaddress[1].any);
    assert(calls[0].length == sizeof(sockaddr_in));
    reset(); nodeconnected[1] = false; SOCK_Send(); assert(calls.empty());
    reset(); nodesocket[1] = ERRSOCKET; SOCK_Send();
    assert(calls.size() == 1 && calls[0].socket == 11);
    reset(); packet.remotenode = BROADCASTADDR; SOCK_Send();
    assert(calls.size() == 2 && calls[0].socket == 11 && calls[1].socket == 12);
    assert(calls[1].length == sizeof(sockaddr_in6));
    reset(); clientaddress[1].any.sa_family = AF_UNSPEC; SOCK_Send();
    assert(calls[0].length == sizeof(mysockaddr_t));
    reset(); result = ERRSOCKET; error_code = EMSGSIZE;
    try { SOCK_Send(); assert(false && "unexpected errors must remain fatal"); }
    catch (const Fatal &fatal) { assert(fatal.error == EMSGSIZE); }
    puts("UDP send error handling passed");
#endif
}
