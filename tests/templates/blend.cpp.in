/// \file blend.cpp.in
/// \brief Native extraction checks for the Direct3D 12 driver's blend, write mask and depth state.
///
/// Executes the production SetBlendMode, D3D_SetBlend, StatePipelineKey, MakeBlendDesc and MakeDepthDesc,
/// so the state a draw would give its pipeline is decoded the way the GPU description is built.
#include <cassert>
#include <cstdio>
#include <cstdint>
#include "doomdef.h"
#include "hardware/hw_defs.h"
#undef min
#undef max
using UINT8=uint8_t;
using UINT32=uint32_t;
using UINT64=uint64_t;
using BOOL=int;
// The values Direct3D 12 gives these constants
enum D3D12_BLEND { D3D12_BLEND_ZERO=1, D3D12_BLEND_ONE=2, D3D12_BLEND_SRC_COLOR=3, D3D12_BLEND_INV_SRC_COLOR=4,
    D3D12_BLEND_SRC_ALPHA=5, D3D12_BLEND_INV_SRC_ALPHA=6, D3D12_BLEND_DEST_COLOR=9, D3D12_BLEND_INV_DEST_COLOR=10 };
enum D3D12_BLEND_OP { D3D12_BLEND_OP_ADD=1, D3D12_BLEND_OP_SUBTRACT=2, D3D12_BLEND_OP_REV_SUBTRACT=3 };
enum D3D12_LOGIC_OP { D3D12_LOGIC_OP_NOOP=5 };
enum { D3D12_COLOR_WRITE_ENABLE_ALL=15 };
struct D3D12_RENDER_TARGET_BLEND_DESC {
    BOOL BlendEnable, LogicOpEnable;
    D3D12_BLEND SrcBlend, DestBlend; D3D12_BLEND_OP BlendOp;
    D3D12_BLEND SrcBlendAlpha, DestBlendAlpha; D3D12_BLEND_OP BlendOpAlpha;
    D3D12_LOGIC_OP LogicOp; UINT8 RenderTargetWriteMask;
};
struct D3D12_BLEND_DESC { BOOL AlphaToCoverageEnable, IndependentBlendEnable; D3D12_RENDER_TARGET_BLEND_DESC RenderTarget[8]; };
enum D3D12_DEPTH_WRITE_MASK { D3D12_DEPTH_WRITE_MASK_ZERO=0, D3D12_DEPTH_WRITE_MASK_ALL=1 };
enum D3D12_COMPARISON_FUNC { D3D12_COMPARISON_FUNC_LESS_EQUAL=4, D3D12_COMPARISON_FUNC_EQUAL=3, D3D12_COMPARISON_FUNC_ALWAYS=8 };
enum D3D12_STENCIL_OP { D3D12_STENCIL_OP_KEEP=1 };
struct D3D12_DEPTH_STENCILOP_DESC {
    D3D12_STENCIL_OP StencilFailOp, StencilDepthFailOp, StencilPassOp; D3D12_COMPARISON_FUNC StencilFunc;
};
struct D3D12_DEPTH_STENCIL_DESC {
    BOOL DepthEnable; D3D12_DEPTH_WRITE_MASK DepthWriteMask; D3D12_COMPARISON_FUNC DepthFunc; BOOL StencilEnable;
    UINT8 StencilReadMask, StencilWriteMask; D3D12_DEPTH_STENCILOP_DESC FrontFace, BackFace;
};
enum D3D12_PRIMITIVE_TOPOLOGY_TYPE { D3D12_PRIMITIVE_TOPOLOGY_TYPE_LINE=2, D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE=3 };
enum D3D12_PRIMITIVE_TOPOLOGY { D3D_PRIMITIVE_TOPOLOGY_LINELIST=2, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST=4 };
enum DXGI_FORMAT { DXGI_FORMAT_R8G8B8A8_UNORM=28, DXGI_FORMAT_D24_UNORM_S8_UINT=45 };
#include "hardware/r_d3d12/pipeline_key.h"
using namespace rr_d3d12;
@@PIPELINE_ENUMS@@
@@ENUMS@@
enum AlphaFunc { AF_ALWAYS, AF_GREATER, AF_NOTEQUAL };
enum TexEnv { TE_MODULATE, TE_REPLACE };
struct {
    bool blend=true; UINT8 blendSrc=BF_ONE,blendDst=BF_ZERO,blendEquation=BE_ADD,colorWriteMask=7;
    int alphaFunc=AF_ALWAYS,texEnv=TE_MODULATE; float alphaRef=0;
    bool alphaTest=true,polygonOffset=false,depthTest=true,depthAlways=false,depthMask=true;
    bool stencil=false,cullFace=false,cullFront=false;
    UINT8 stencilFunc=D3D12_COMPARISON_FUNC_EQUAL,stencilRef=0,stencilFail=D3D12_STENCIL_OP_KEEP,
        stencilDepthFail=D3D12_STENCIL_OP_KEEP,stencilPass=D3D12_STENCIL_OP_KEEP,stencilReadMask=255,stencilWriteMask=255;
} g_gl;
FBITFIELD g_currentPolyFlags=0;
void SetRepeatT(bool) {} void SetRepeatS(bool) {} void SetNoTexture(int) {}
bool g_waterRefraction=false, g_fogRemap=false;
@@BLEND@@
@@BLEND_DESC@@
@@DEPTH_DESC@@
@@STATE_KEY@@
@@SET_BLEND_MODE@@
@@SET_BLEND@@
// What the next draw would give its pipeline
struct Resolved { D3D12_RENDER_TARGET_BLEND_DESC color; D3D12_DEPTH_STENCIL_DESC depth; };
static Resolved Resolve() {
    const PipelineKey key=StatePipelineKey(LAYOUT_POLY,VS_POLY,PS_FIXED,D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
    return {MakeBlendDesc(key.blend).RenderTarget[0],MakeDepthDesc(key.depth)};
}
int main() {
    // A water refraction or fog remap composite writes the final color itself: it disables blending but keeps the
    // write mask. Leaving it restores the ordinary blend, however often the override was used.
    for(bool fog : {false,true}) for(UINT8 mask : {0,7}) {
        g_currentPolyFlags=0xffffffff;
        D3D_SetBlend(PF_Translucent|(mask?0:PF_Invisible));
        const auto ordinary=Resolve().color;
        assert(ordinary.BlendEnable && ordinary.SrcBlend==D3D12_BLEND_SRC_ALPHA && ordinary.DestBlend==D3D12_BLEND_INV_SRC_ALPHA);
        assert(ordinary.RenderTargetWriteMask==mask);
        for(int use=0;use<5;++use) {
            g_fogRemap=fog; g_waterRefraction=!fog;
            const auto remap=Resolve().color;
            assert(!remap.BlendEnable && remap.RenderTargetWriteMask==mask);
            assert(!Resolve().color.BlendEnable);
            // The next surface's SetBlend ends the override, with the translucent factors untouched
            D3D_SetBlend(PF_Translucent|(mask?0:PF_Invisible));
            assert(!g_fogRemap && !g_waterRefraction);
            const auto restored=Resolve().color;
            assert(restored.BlendEnable && restored.SrcBlend==D3D12_BLEND_SRC_ALPHA && restored.DestBlend==D3D12_BLEND_INV_SRC_ALPHA);
            assert(restored.BlendOp==D3D12_BLEND_OP_ADD && restored.RenderTargetWriteMask==mask);
        }
    }
    // Depth-only sky walls and linkdraw sprite silhouettes can use different blend modes while PF_Invisible remains
    // set. Every transition must leave the target unchanged and keep depth writes, then restore the visible
    // surface's actual blend.
    const FBITFIELD modes[]={0,PF_Masked,PF_Translucent,PF_Environment,PF_Additive,
        PF_Subtractive,PF_ReverseSubtract,PF_Multiplicative,PF_Invert,PF_Fog};
    D3D_SetBlend(PF_Translucent|PF_Invisible|PF_Occlude);
    D3D_SetBlend(PF_Invisible|PF_NoTexture|PF_Occlude);
    assert(Resolve().color.RenderTargetWriteMask==0);
    int transitions=0;
    for(auto from:modes) for(auto to:modes) {
        D3D_SetBlend(from|PF_Invisible|PF_Occlude);
        D3D_SetBlend(to|PF_Invisible|PF_NoTexture|PF_Occlude);
        const auto hidden=Resolve();
        assert(hidden.color.RenderTargetWriteMask==0);
        assert(hidden.depth.DepthEnable && hidden.depth.DepthWriteMask==D3D12_DEPTH_WRITE_MASK_ALL);
        assert(hidden.depth.DepthFunc==D3D12_COMPARISON_FUNC_LESS_EQUAL);
        D3D_SetBlend(to|PF_Occlude);
        const auto visible=Resolve();
        assert(visible.color.RenderTargetWriteMask==7);
        // The blend is what SetBlendMode gives this mode alone
        SetBlendMode(to);
        const auto expected=Resolve().color;
        assert(visible.color.BlendEnable==expected.BlendEnable);
        assert(visible.color.SrcBlend==expected.SrcBlend && visible.color.DestBlend==expected.DestBlend);
        assert(visible.color.BlendOp==expected.BlendOp);
        const bool opaque=g_gl.blendSrc==BF_ONE && g_gl.blendDst==BF_ZERO && g_gl.blendEquation==BE_ADD;
        assert(visible.color.BlendEnable==!opaque);
        ++transitions;
    }
    printf("%d invisible/visible blend transitions preserve color and depth, and restore visible blending\n",transitions);
    puts("Remap composites disable blending, keep write masks and restore the ordinary blend");
}
