@@OPEN@@
int main() {
    queued = {{SDL_CONTROLLERDEVICEADDED, {0}}, {SDL_CONTROLLERBUTTONDOWN, {0}},
              {SDL_CONTROLLERDEVICEADDED, {1}}, {SDL_CONTROLLERDEVICEADDED, {2}}};
    I_OpenStartupGamepads();
    assert((opened == std::vector<int>{0, 1, 2}));
    assert(posted.size() == 2);
    assert(posted[0].type == ev_gamepad_device_added && posted[0].device == 11);
    assert(posted[1].device == 21);
    assert(queued.size() == 1 && queued.front().type == SDL_CONTROLLERBUTTONDOWN);
    I_OpenStartupGamepads();
    assert(opened.size() == 3 && posted.size() == 2); // no duplicate opens
    queued.push_back({SDL_CONTROLLERDEVICEADDED, {1}});
    I_OpenStartupGamepads(); // later hotplug still uses the same handler
    assert(opened.size() == 4 && posted.back().device == 21);
}
