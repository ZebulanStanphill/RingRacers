struct Draw{std::array<FOutVector,4> vertices;INT32 line,side,light;FBITFIELD flags;UINT8 alpha;bool queued,fog;extracolormap_t *colormap;};
static std::vector<Draw> draws;
static void Record(FOutVector *v,FSurfaceInfo *s,FBITFIELD f,INT32 l,extracolormap_t *c,bool queued,bool isFog){
 Draw d{};std::copy(v,v+4,d.vertices.begin());d.line=currentLine;d.side=currentSide;d.light=l;d.flags=f;d.alpha=s->PolyColor.s.alpha;d.queued=queued;d.fog=isFog;d.colormap=c;draws.push_back(d);
}
static void HWR_ProjectWall(FOutVector *v,FSurfaceInfo *s,FBITFIELD f,INT32 l,extracolormap_t *c){Record(v,s,f,l,c,false,false);}
static void HWR_AddTransparentWall(FOutVector *v,FSurfaceInfo *s,INT32,INT32,FBITFIELD f,boolean isFog,INT32 l,extracolormap_t *c){Record(v,s,f,l,c,true,isFog);}
static void HWR_DrawSkyWall(FOutVector *v,FSurfaceInfo *s){Record(v,s,PF_Invisible|PF_NoTexture,255,nullptr,false,false);}
