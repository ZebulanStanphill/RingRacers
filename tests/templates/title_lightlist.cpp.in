  static void AppendFOF(int target,int control,int line,ffloortype_e flags){
   static int next=0;auto &r=rovers[next++];r.target=mapSectors+target;r.secnum=control;r.master=mapLines+line;
   auto &c=mapSectors[control];r.topheight=&c.ceilingheight;r.bottomheight=&c.floorheight;r.toplightlevel=&c.lightlevel;
   r.t_slope=&c.c_slope;r.b_slope=&c.f_slope;r.toppic=&c.ceilingpic;r.bottompic=&c.floorpic;r.alpha=255;r.fofflags=flags;
   auto **at=&mapSectors[target].ffloors;while(*at)at=&(*at)->next;*at=&r;
  }
