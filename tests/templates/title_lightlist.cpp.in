static std::vector<int> visitedSky;
static void HWR_Subsector(size_t idx){
 auto *sub=mapSubs+idx;PrepareSubsector(sub);
 if(gl_frontsector->ceilingpic==skyflatnum || gl_frontsector->floorpic==skyflatnum){drawsky=true;visitedSky.push_back(int(sub->sector-mapSectors));}
 for(int k=sub->firstline;k<sub->firstline+sub->numlines;k++){
  auto *seg=mapSegs+k;if(seg->glseg)continue;
  currentLine=int(seg->linedef-mapLines);currentSide=seg->side;
  inAddLine=true;HWR_AddLine(seg);inAddLine=false;
 }
}
static bool Same(const Draw&a,const Draw&b){
 if(a.line!=b.line||a.side!=b.side||a.light!=b.light||a.flags!=b.flags||a.alpha!=b.alpha||a.queued!=b.queued||a.fog!=b.fog||a.colormap!=b.colormap)return false;
 for(int i=0;i<4;i++)if(a.vertices[i].x!=b.vertices[i].x||a.vertices[i].y!=b.vertices[i].y||a.vertices[i].z!=b.vertices[i].z||a.vertices[i].s!=b.vertices[i].s||a.vertices[i].t!=b.vertices[i].t)return false;
 return true;
}


static void Dump(const Draw&d,size_t i){
 auto*c=d.colormap;
 printf("SUBMISSION %zu line=%d side=%d light=%d flags=%08lx alpha=%u queued=%d fog=%d cmap=%d:%08x:%08x:%u:%u:%u",i,d.line,d.side,d.light,static_cast<unsigned long>(d.flags),d.alpha,d.queued,d.fog,c!=nullptr,c?unsigned(c->rgba):0,c?unsigned(c->fadergba):0,c?c->fadestart:0,c?c->fadeend:0,c?c->flags:0);
 for(auto&v:d.vertices)printf(" (%a,%a,%a,%a,%a)",double(v.x),double(v.y),double(v.z),double(v.s),double(v.t));
 printf("\n");
}
static void CheckPreparationCases(){
 seg_t *seg=nullptr;
 for(auto&s:mapSegs)if(!s.glseg && s.linedef==mapLines+22 && s.side==1 && s.backsector){seg=&s;break;}
 assert(seg);auto *real=seg->backsector;assert(real->ffloors && real->numlights);
 gl_frontsector=seg->frontsector;currentLine=22;currentSide=1;
 auto call=[&](){gld_clipper_Clear();lastFakeInput=lastFakeOutput=nullptr;HWR_AddLine(seg);};
 real->moved=true;std::vector<std::pair<sector_t*,boolean>> controlMoved;for(auto*r=real->ffloors;r;r=r->next)controlMoved.push_back({sectors+r->secnum,sectors[r->secnum].moved});
 size_t n=prepCalls.size();call();assert(prepCalls.size()==n && real->moved);assert(lastFakeInput==real && lastFakeOutput==real);
 auto*back=seg->backsector;seg->backsector=nullptr;call();assert(prepCalls.size()==n);seg->backsector=back;
 auto *fofs=real->ffloors;auto lights=real->numlights;real->ffloors=nullptr;real->numlights=0;call();assert(prepCalls.size()==n);real->ffloors=fofs;real->numlights=lights;
 FreeLights(*real);real->numlights=0;real->moved=true;
 hwr_portalsearch=true;call();assert(prepCalls.size()==n && real->numlights==0 && real->moved);hwr_portalsearch=false;
 fakeMode=true;call();fakeMode=false;
 assert(prepCalls.size()==n+1 && prepCalls.back()==real && real->numlights>0 && real->moved);
 assert(lastFakeInput==real && lastFakeOutput && lastFakeOutput!=real && lastFakeOutput->lightlist==real->lightlist);
 assert(gl_backsector==lastFakeOutput);for(auto&c:controlMoved)assert(c.first->moved==c.second);
 // The next normal subsector preparation retains authority to refresh moved lists.
 subsector_t sub{};sub.sector=real;PrepareSubsector(&sub);
 assert(prepCalls.size()==n+2 && !real->moved);
 printf("CASES valid/null-back/no-fofs/portal-search/cold-real-before-fake/moved-controls-preserved/subsector-refresh asserted\n");
}
// What R_Prep3DFloors builds for two of the title map's sectors, worked out by hand from the authored map
// (fixtures/title-map.json) instead of read back from the code, so a wrong list can't be hidden by the replay
// being differential. A list's first entry is the sector's own light, one fixed-point unit (1/65536) above its ceiling; each lit FOF
// then adds an entry at its top. A fog FOF (control sector 61: floor 96, ceiling 528, light 0, black colormap) is
// double-shadowed, so it also adds one at its bottom that restores the sector's light. A FOF with NOSHADE that
// does not cut (the colormap-only controls 59, 16, 2, 29) adds nothing, while a solid FOF with NOSHADE (controls
// 19 and 10, which cut) adds an entry that keeps the light and colormap of the entry above it.
struct LightExpect{fixed_t height;INT32 light;extracolormap_t *colormap;int control;};
static void CheckPreparedList(int sector,std::initializer_list<LightExpect> expected){
 auto &s=mapSectors[sector];assert(!s.c_slope);
 assert(s.numlights==(INT32)expected.size());
 int i=0;
 for(auto &e:expected){
  auto &l=s.lightlist[i++];
  assert(l.height==e.height && !l.slope);
  assert(*l.lightlevel==e.light && *l.extra_colormap==e.colormap);
  if(e.control<0)assert(!l.caster && !l.flags);
  else assert(l.caster && l.caster->secnum==size_t(e.control) && l.flags==l.caster->fofflags);
 }
}
static void CheckPreparedLists(){
 // Sector 31: ceiling 312, light 104, with colormap-only FOFs (59, 16) and the fog (61).
 CheckPreparedList(31,{{312*FRACUNIT+1,104,nullptr,-1},{528*FRACUNIT,0,&fog,61},{96*FRACUNIT,104,nullptr,61}});
 // Sector 23: ceiling 360, light 199, with solid FOFs 10 (top 336) and 19 (top 240) between the fog's top and bottom.
 CheckPreparedList(23,{{360*FRACUNIT+1,199,nullptr,-1},{528*FRACUNIT,0,&fog,61},{336*FRACUNIT,0,&fog,10},
  {240*FRACUNIT,0,&fog,19},{96*FRACUNIT,199,nullptr,61}});
}
static std::vector<Draw> Traverse(){
 draws.clear();visitedSky.clear();drawsky=false;gld_clipper_Clear();
 const angle_t a1=gld_FrustumAngle(0);
 gld_clipper_SafeAddClipRange(ANGLE_90+a1,ANGLE_90-a1);HWR_RenderBSPNode(fixtureRoot);
 int fogCount=0;for(auto&d:draws)fogCount+=d.fog;
 assert(draws.size()==58 && fogCount==5 && drawsky && visitedSky.size()==16);
 return draws;
}
// One-sided middle textures on a sloped floor, against Software's R_StoreWallRange: the row at height z is
// mid - z, where mid is the wall's top (worldtop, the default), its floor plus the texture height (worldbottom +
// texheight, lower unpegged, following the floor's slope), or with NOSKEW the sector's flat ceilingheight or
// floorheight + texheight. Legacy GL put lower-unpegged textures off by the floor's slope at the wall's start.
static void CheckOneSidedPegging(){
 seg_t *seg=nullptr;
 for(auto&sg:mapSegs)if(!sg.glseg && !sg.backsector && sg.sidedef && sg.sidedef->midtexture && !sg.linedef->special){seg=&sg;break;}
 assert(seg);
 sector_t *sec=seg->frontsector;const sector_t saved=*sec;const UINT32 savedFlags=seg->linedef->flags;const fixed_t savedRow=seg->sidedef->rowoffset;
 const float x1=((polyvertex_t*)seg->pv1)->x,y1=((polyvertex_t*)seg->pv1)->y,x2=((polyvertex_t*)seg->pv2)->x,y2=((polyvertex_t*)seg->pv2)->y;
 const double len=std::hypot(double(x2-x1),double(y2-y1));assert(len>8);
 pslope_t slope{};slope.o.x=FLOAT_TO_FIXED(x1);slope.o.y=FLOAT_TO_FIXED(y1);slope.o.z=24*FRACUNIT; // 24 above floorheight at the start
 slope.d.x=FLOAT_TO_FIXED((x2-x1)/len);slope.d.y=FLOAT_TO_FIXED((y2-y1)/len);slope.zdelta=FRACUNIT/4;
 sec->floorheight=0;sec->ceilingheight=512*FRACUNIT;sec->floorpic=sec->ceilingpic=skyflatnum+1;sec->f_slope=&slope;sec->c_slope=nullptr;sec->numlights=0;sec->ffloors=nullptr;
 seg->sidedef->rowoffset=5*FRACUNIT;
 const double texh=64*FRACUNIT,ro=5*FRACUNIT,unit=64*FRACUNIT;
 const double bottom[2]={double(P_GetZAt(&slope,FLOAT_TO_FIXED(x1),FLOAT_TO_FIXED(y1),0)),double(P_GetZAt(&slope,FLOAT_TO_FIXED(x2),FLOAT_TO_FIXED(y2),0))};
 const double top=512*FRACUNIT;assert(bottom[1]>bottom[0]+FRACUNIT);
 struct Mode{UINT32 flags;const char *name;};
 for(Mode m:{Mode{0,"top"},Mode{ML_DONTPEGBOTTOM,"lower unpegged"},Mode{ML_NOSKEW,"noskew"},Mode{ML_NOSKEW|ML_DONTPEGBOTTOM,"noskew lower unpegged"}}){
  seg->linedef->flags=(savedFlags&~(ML_DONTPEGBOTTOM|ML_NOSKEW|ML_DONTPEGTOP|ML_SKEWTD))|m.flags;
  draws.clear();gl_curline=seg;gl_frontsector=sec;gl_backsector=nullptr;currentLine=int(seg->linedef-mapLines);currentSide=seg->side;
  HWR_ProcessSeg();
  if(draws.size()!=1)printf("one-sided %s: %zu draws\n",m.name,draws.size());
  assert(draws.size()==1);const auto &v=draws[0].vertices;
  for(int end=0;end<2;++end){
   const double mid=!(m.flags&ML_NOSKEW)?((m.flags&ML_DONTPEGBOTTOM)?bottom[end]+texh:top)
    :((m.flags&ML_DONTPEGBOTTOM)?0+texh:top);
   const FOutVector &lo=v[end],&hi=v[3-end];
   const double wantLo=(mid+ro-bottom[end])/unit,wantHi=(mid+ro-top)/unit;
   if(std::fabs(lo.t-wantLo)>1e-4||std::fabs(hi.t-wantHi)>1e-4)
    printf("one-sided %s end %d: rows %.5f..%.5f, Software %.5f..%.5f\n",m.name,end,hi.t,lo.t,wantHi,wantLo);
   assert(std::fabs(lo.t-wantLo)<=1e-4 && std::fabs(hi.t-wantHi)<=1e-4);
  }
 }
 *sec=saved;seg->linedef->flags=savedFlags;seg->sidedef->rowoffset=savedRow;draws.clear();
 printf("one-sided middle textures on a sloped floor match Software in all four pegging modes\n");
}
static size_t Differences(const std::vector<Draw>&a,const std::vector<Draw>&b){
 assert(a.size()==b.size());size_t count=0;
 for(size_t i=0;i<a.size();++i)count+=!Same(a[i],b[i]);return count;
}
int main(){
 InitFixture();assert(slopecount==72);
 // Every wall whose cold lighting changes is outside authored slope targets;
 // all FOF controls are unsloped as well. Keep slopes for the other geometry.
 for(int line : {22,70,111,123,166,188,199,203}) {
  assert(!mapLines[line].frontsector->f_slope && !mapLines[line].frontsector->c_slope);
  assert(!mapLines[line].backsector->f_slope && !mapLines[line].backsector->c_slope);
 }
 for(int i=0;i<fixtureSectors;++i)for(auto *r=mapSectors[i].ffloors;r;r=r->next) {
  assert(!mapSectors[r->secnum].f_slope && !mapSectors[r->secnum].c_slope);
 }
 // Explicitly prepare every list to obtain a warm reference, including sectors
 // outside the visited subsectors. Then restore the real cold map-load state.
 for(int i=0;i<fixtureSectors;++i)if(mapSectors[i].ffloors)R_Prep3DFloors(mapSectors+i);
 CheckPreparedLists();
 // Callers zero numlights before re-preparing a moved sector: the allocation must be kept, with identical contents.
 for(int i=0;i<fixtureSectors;++i)if(mapSectors[i].ffloors){
  auto &s=mapSectors[i];auto *list=s.lightlist;INT32 n=s.numlights;std::vector<lightlist_t> before(list,list+n);
  s.numlights=0;R_Prep3DFloors(&s);
  assert(s.lightlist==list && s.numlights==n && !memcmp(before.data(),list,n*sizeof(lightlist_t)));
 }
 CheckPreparedLists();
 for(int i=0;i<fixtureSectors;++i)mapSectors[i].moved=false;
 auto reference=Traverse();
 for(int i=0;i<fixtureSectors;++i){FreeLights(mapSectors[i]);mapSectors[i].numlights=0;mapSectors[i].moved=true;}
 addLinePreps.clear();
 auto first=Traverse();
 // The replay must exercise the fix: walls whose back sector has FOFs but a cold light list are first
 // seen through HWR_AddLine, before any subsector visit prepares that sector. Without the preparation
 // there, nothing is prepared from HWR_AddLine and the cold walls differ from the reference.
 assert(!addLinePreps.empty());
 for(auto *s:addLinePreps)assert(s->ffloors && s->numlights>0);
 auto second=Traverse();
 size_t differences=Differences(first,reference),secondDifferences=Differences(first,second);
 assert(Differences(second,reference)==0);
 printf("58 title walls: cold/warm differences=%zu; first/second differences=%zu; slopes=%u\n",differences,secondDifferences,slopecount);
 if(!differences && !secondDifferences)CheckPreparationCases();
 CheckOneSidedPegging();
 gld_clipper_Clear();while(freelist){auto*n=freelist->next;free(freelist);freelist=n;}
 for(int i=0;i<fixtureSectors;i++)FreeLights(mapSectors[i]);
 while(slopelist){auto*n=slopelist->next;free(slopelist);slopelist=n;}
 // A mismatch was printed above; fail with an ordinary exit status.
 return differences || secondDifferences ? 1 : 0;
}
