/// \file custom_dispatch.cpp.in
/// \brief Native extraction checks for the Direct3D 12 driver's add-on shader loading and selection.
///
/// Executes the production D3D_LoadCustomShader, D3D_CompileShaders, D3D_CleanShaders, D3D_SetShader and
/// CustomDrawProgram. Only translation, shader compilation and pipeline creation are stubs, so failures
/// can be injected at any layout. The WARP pixel scenes in d3d12-driver.cpp cover what the GPU draws.
#include <cassert>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <memory>
#include <string>
#include <unordered_map>
#include <vector>
#include "doomdef.h"
#include "command.h"
#include "hardware/hw_defs.h"
#include "hardware/hw_glsl.h"
#include "hardware/r_d3d12/custom_shader.h"
#undef min
#undef max
using UINT16=uint16_t;
using UINT64=uint64_t;
#define D3D12_LOG_ONCE(...) ((void)0)
#include "hardware/r_d3d12/pipeline_key.h"
using namespace rr_d3d12;
@@PIPELINE_ENUMS@@
// The pieces of Direct3D that the extracted code names
enum { D3D12_COMPARISON_FUNC_EQUAL=3, D3D12_STENCIL_OP_KEEP=1 };
enum D3D12_PRIMITIVE_TOPOLOGY_TYPE { D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE=3 };
struct ID3DBlob {}; struct ID3D12PipelineState {};
template<class T> struct ComPtr {
    std::shared_ptr<T> p;
    T* Get() const{return p.get();} void Reset(){p.reset();}
    explicit operator bool() const{return bool(p);}
};
struct UploadAllocation { void *cpu=nullptr; };
// What the add-on tests record or inject
static std::vector<std::string> logLines;
static void Log(const char *format,...) {
    char line[512]; va_list args; va_start(args,format); vsnprintf(line,sizeof line,format,args); va_end(args);
    logLines.push_back(line);
}
static bool LogHas(const char *text) {
    for(const auto &line:logLines) if(line.find(text)!=std::string::npos) return true;
    return false;
}
static int deviceStub;
static void *Core_Device() { return &deviceStub; }
static void Core_Retire(ComPtr<ID3D12PipelineState> &) {}
hwdshaderoption_t g_allowShaders=HWD_SHADEROPTION_ON;
bool g_shadersEnabled=false,g_shaderChanged=false,g_modelLighting=false,g_postImage=false;
bool g_waterRefraction=false,g_fogRemap=false;
int g_program=-1,g_shaderCurrent=-1,g_shaderType=0;
consvar_t cv_reducevfx{};
UploadAllocation g_customViewConstants;
UINT64 g_customViewFrame=0;
std::unordered_map<PipelineKey,ComPtr<ID3D12PipelineState>,PipelineKeyHash> g_pipelines;
PipelineKey g_lastKey={};
ID3D12PipelineState *g_lastPipeline=nullptr,*g_boundPipeline=nullptr;
@@CUSTOM_STATE@@
@@PROGRAM_EXISTS@@
// Translation, shader compilation and pipeline creation, with failures to inject
struct Call { std::string vertex,fragment; int layout; bool refraction; };
static std::vector<Call> calls;
static int stageCompiles=0,pipelineCreations=0,failStageLayout=-1,failPipelineLayout=-1;
static bool failRefractionStage=false,failRefractionPipeline=false;
static const char *failStage="";
bool TranslateLegacyShader(const std::string &v,const std::string &p,int layout,
    LegacyShaderHLSL &out,std::string &error,bool refraction) {
    calls.push_back({v,p,layout,refraction});
    if(v=="bad"||p=="bad"||(refraction&&p=="no refraction")){error="invalid shader";return false;}
    if(refraction) assert(layout==LAYOUT_POLY);
    // The layout rides along in the text, so the compile stub can fail one layout
    const std::string tag="L"+std::to_string(layout)+":";
    out={tag+v,tag+(refraction?p+" refraction":p)};return true;
}
static bool CompileCustomStage(const std::string &hlsl,const char *profile,ComPtr<ID3DBlob> &code) {
    ++stageCompiles;
    assert(!strcmp(profile,"vs_5_1")||!strcmp(profile,"ps_5_1"));
    const bool refraction=hlsl.size()>11 && hlsl.compare(hlsl.size()-11,11," refraction")==0;
    if(refraction && failRefractionStage) return false;
    if(failStageLayout>=0 && !strcmp(profile,failStage) && hlsl.compare(0,3,"L"+std::to_string(failStageLayout)+":")==0) return false;
    code.p=std::make_shared<ID3DBlob>();return true;
}
static ID3D12PipelineState *FindOrCreatePipeline(const PipelineKey &key) {
    ++pipelineCreations;
    const bool refraction=key.custom && key.ps>=NUMPS && (key.ps-NUMPS)%2==1;
    if(refraction ? failRefractionPipeline : key.layout==failPipelineLayout) return nullptr;
    auto &entry=g_pipelines[key];
    if(!entry) entry.p=std::make_shared<ID3D12PipelineState>();
    return entry.Get();
}
@@RETIRE@@
@@ADVANCE@@
@@VALIDATION_KEY@@
@@COMPILE@@
@@CLEAN@@
@@LOAD@@
@@SET_SHADER@@
static void Load(int type,const char *code,bool fragment=true) {
    D3D_LoadCustomShader(type,const_cast<char*>(code),std::strlen(code),fragment);
}
static const CustomProgram *Draw(int type,Layout layout) { g_program=type; return CustomDrawProgram(layout); }
static int CustomPipelines(int type) {
    int count=0;
    for(const auto &entry:g_pipelines) count+=entry.first.custom && entry.first.vs==NUMVS+type;
    return count;
}
static void ExpectDiscarded(int type) {
    const CustomShader &shader=g_customShaders[type];
    assert(!shader.valid);
    for(const auto &program:shader.programs) assert(!program.vertex&&!program.pixel&&!program.refraction);
    for(Layout layout:{LAYOUT_POLY,LAYOUT_SKY,LAYOUT_MODEL}) assert(!Draw(type,layout));
    assert(CustomPipelines(type)==0);
}
int main() {
    const Layout layouts[]={LAYOUT_POLY,LAYOUT_SKY,LAYOUT_MODEL};
    // No add-on shaders: nothing is translated, compiled or created, and the built-in programs are selected.
    assert(D3D_CompileShaders());
    assert(calls.empty()&&stageCompiles==0&&pipelineCreations==0&&g_pipelines.empty());
    for(int type=1;type<NUMBASESHADERS;++type) for(Layout layout:layouts) assert(!Draw(type,layout));
    // A fragment-only replacement gets the real built-in vertex stage for every layout, and is selected per layout.
    Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders());
    assert(calls.size()==3&&stageCompiles==6&&pipelineCreations==3);
    for(int layout=0;layout<3;++layout) {
        assert(calls[layout].layout==layout&&!calls[layout].refraction);
        assert(calls[layout].vertex==gl_shadersources[SHADER_WALL].vertex&&calls[layout].fragment=="fragment");
    }
    const CustomShader &wall=g_customShaders[SHADER_WALL];
    assert(wall.valid&&wall.generation==g_customGeneration&&CustomPipelines(SHADER_WALL)==3);
    for(Layout layout:layouts) {
        const CustomProgram *program=Draw(SHADER_WALL,layout);
        assert(program==&wall.programs[layout]&&program->vertex&&program->pixel&&!program->refraction);
    }
    assert(wall.programs[LAYOUT_POLY].vertex.Get()!=wall.programs[LAYOUT_SKY].vertex.Get());
    // Other base shaders keep their built-in programs
    for(Layout layout:layouts) assert(!Draw(SHADER_FLOOR,layout));
    // Recompiling without changes translates, compiles and creates nothing
    const size_t translated=calls.size();const int compiled=stageCompiles,created=pipelineCreations;
    assert(D3D_CompileShaders());
    assert(calls.size()==translated&&stageCompiles==compiled&&pipelineCreations==created);
    // Ignore custom shaders, shaders off and postprocessing all bypass the add-on
    for(auto mode:{HWD_SHADEROPTION_OFF,HWD_SHADEROPTION_NOCUSTOM}) {
        g_allowShaders=mode;for(Layout layout:layouts) assert(!Draw(SHADER_WALL,layout));
    }
    g_allowShaders=HWD_SHADEROPTION_ON;
    g_postImage=true;for(Layout layout:layouts) assert(!Draw(SHADER_WALL,layout));
    g_postImage=false;
    // A replacement that fails to translate, compile or create atomically discards the whole replacement
    // (including a working one it replaces), leaves the built-ins in use, and a later good load works again.
    Load(SHADER_WALL,"bad");assert(D3D_CompileShaders());
    ExpectDiscarded(SHADER_WALL);assert(LogHas("keeping the built-in shader"));
    Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders()&&g_customShaders[SHADER_WALL].valid);
    for(const char *stage:{"vs_5_1","ps_5_1"}) for(int layout=0;layout<3;++layout) {
        failStage=stage;failStageLayout=layout;
        Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders());
        ExpectDiscarded(SHADER_WALL);
        failStageLayout=-1;
        Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders());
        assert(g_customShaders[SHADER_WALL].valid&&Draw(SHADER_WALL,(Layout)layout));
    }
    for(int layout=0;layout<3;++layout) {
        logLines.clear();failPipelineLayout=layout;
        Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders());
        ExpectDiscarded(SHADER_WALL);assert(LogHas("pipeline validation failed"));
        failPipelineLayout=-1;
        Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders());
        assert(g_customShaders[SHADER_WALL].valid&&CustomPipelines(SHADER_WALL)==3);
    }
    // One type's failure leaves another type's replacement alone
    Load(SHADER_FLOOR,"floor");assert(D3D_CompileShaders()&&g_customShaders[SHADER_FLOOR].valid);
    failPipelineLayout=LAYOUT_MODEL;Load(SHADER_WALL,"fragment");assert(D3D_CompileShaders());
    ExpectDiscarded(SHADER_WALL);assert(g_customShaders[SHADER_FLOOR].valid&&Draw(SHADER_FLOOR,LAYOUT_MODEL));
    failPipelineLayout=-1;
    // Billboard clipping shares the sprite replacement, including its vertex stage once supplied
    calls.clear();
    Load(SHADER_SPRITE,"sprite");assert(D3D_CompileShaders());
    assert(g_customShaders[SHADER_SPRITECLIPHACK].fragment=="sprite"&&g_customShaders[SHADER_SPRITECLIPHACK].valid);
    assert(g_customShaders[SHADER_SPRITE].valid&&Draw(SHADER_SPRITECLIPHACK,LAYOUT_POLY));
    bool clipVertex=false;
    for(const auto &call:calls) clipVertex=clipVertex||(call.vertex==gl_shadersources[SHADER_SPRITECLIPHACK].vertex&&call.fragment=="sprite");
    assert(clipVertex);
    Load(SHADER_SPRITE,"sprite vertex",false);assert(D3D_CompileShaders());
    assert(g_customShaders[SHADER_SPRITECLIPHACK].vertex=="sprite vertex"&&g_customShaders[SHADER_SPRITECLIPHACK].valid);
    // A custom model shader is kept for lit models unless a separate model-lighting replacement is supplied
    Load(SHADER_MODEL,"model");assert(D3D_CompileShaders());
    g_modelLighting=true;
    D3D_SetShader(SHADER_MODEL);assert(g_shaderCurrent==SHADER_MODEL);
    g_allowShaders=HWD_SHADEROPTION_NOCUSTOM;D3D_SetShader(SHADER_MODEL);assert(g_shaderCurrent==SHADER_MODEL_LIGHTING);
    g_allowShaders=HWD_SHADEROPTION_ON;D3D_SetShader(SHADER_MODEL);assert(g_shaderCurrent==SHADER_MODEL);
    Load(SHADER_MODEL_LIGHTING,"lit model");assert(D3D_CompileShaders());
    D3D_SetShader(SHADER_MODEL);assert(g_shaderCurrent==SHADER_MODEL_LIGHTING);
    g_modelLighting=false;D3D_SetShader(SHADER_MODEL);assert(g_shaderCurrent==SHADER_MODEL);
    // Reduce VFX replaces the water shader, and no shader and Shaders Off disable programs
    cv_reducevfx.value=1;D3D_SetShader(SHADER_WATER);assert(g_shaderCurrent==SHADER_FLOOR);
    cv_reducevfx.value=0;
    // Choosing a shader ends any water or fog composite
    g_waterRefraction=g_fogRemap=true;D3D_SetShader(SHADER_WALL);assert(!g_waterRefraction&&!g_fogRemap);
    D3D_SetShader(SHADER_NONE);assert(!g_shadersEnabled&&g_program==-1&&g_shaderCurrent==-1);
    D3D_SetShader(SHADER_WALL);assert(g_shadersEnabled&&g_shaderCurrent==SHADER_WALL);
    g_allowShaders=HWD_SHADEROPTION_OFF;D3D_SetShader(SHADER_WALL);assert(!g_shadersEnabled);
    g_allowShaders=HWD_SHADEROPTION_ON;
    // Custom water gets a polygon-only composite variant, translated after its three ordinary layouts
    for(Layout layout:layouts) assert(!Draw(SHADER_WATER,layout));
    calls.clear();const int pipelinesBefore=pipelineCreations;
    Load(SHADER_WATER,"custom water");assert(D3D_CompileShaders());
    assert(calls.size()==4&&!calls[2].refraction&&calls[3].refraction&&calls[3].layout==LAYOUT_POLY);
    assert(calls[3].vertex==gl_shadersources[SHADER_WATER].vertex&&calls[3].fragment=="custom water");
    const CustomProgram *water=g_customShaders[SHADER_WATER].programs;
    assert(g_customShaders[SHADER_WATER].valid&&water[LAYOUT_POLY].refraction);
    assert(!water[LAYOUT_SKY].refraction&&!water[LAYOUT_MODEL].refraction);
    assert(pipelineCreations==pipelinesBefore+4&&CustomPipelines(SHADER_WATER)==4);
    assert(Draw(SHADER_WATER,LAYOUT_POLY)->refraction.Get()==water[LAYOUT_POLY].refraction.Get());
    // A refraction variant that fails to translate, compile or validate leaves valid, unrefracted custom water
    for(int failure=0;failure<3;++failure) {
        logLines.clear();
        failRefractionStage=failure==1;failRefractionPipeline=failure==2;
        Load(SHADER_WATER,failure==0?"no refraction":"custom water");assert(D3D_CompileShaders());
        assert(g_customShaders[SHADER_WATER].valid&&water[LAYOUT_POLY].pixel&&!water[LAYOUT_POLY].refraction);
        assert(LogHas("without refraction"));
        for(Layout layout:layouts) assert(Draw(SHADER_WATER,layout)==&water[layout]);
    }
    failRefractionStage=failRefractionPipeline=false;
    Load(SHADER_WATER,"bad");assert(D3D_CompileShaders());ExpectDiscarded(SHADER_WATER);
    // Cleaning discards every replacement and its pipelines
    const UINT16 generation=g_customGeneration;
    D3D_CleanShaders();
    assert(g_customGeneration!=generation&&g_customGeneration!=0);
    for(const auto &shader:g_customShaders) assert(!shader.valid&&shader.vertex.empty()&&shader.fragment.empty());
    for(const auto &entry:g_pipelines) assert(!entry.first.custom);
    for(int type=1;type<NUMBASESHADERS;++type) for(Layout layout:layouts) assert(!Draw(type,layout));
    assert(!g_customViewConstants.cpu&&g_customViewFrame==UINT64_MAX);
    puts("Production custom dispatch: built-in selection, vertex defaults, atomic discard on translation, compile and pipeline failures, recompile caching, sprite clipping, model lighting and water refraction passed");
}
