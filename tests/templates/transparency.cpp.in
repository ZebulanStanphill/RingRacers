float gl_viewsin, gl_viewcos = 1;
angle_t viewangle;
fixed_t viewz, rendertimefrac = FRACUNIT;
UINT8 paused;
FTransform atransform{};
static sector_t *gl_frontsector;
static UINT32 gl_visspritecount;
static gl_vissprite_t testSprites[64];
gl_vissprite_t *gl_vsprorder[MAXVISSPRITES];
static mobj_t mobjs[64];
md2_t md2_models[NUMSPRITES]{}, md2_playermodels[MAXSKINS]{};
precise_t ps_hw_nodesorttime, ps_hw_nodedrawtime;
