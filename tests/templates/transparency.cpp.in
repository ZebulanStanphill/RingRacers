// Platform allocator stubs retain the production allocation sizes. The wrapper
// only permits C's void-pointer conversions when extracting C into this C++ harness.
static std::set<void *> allocations;
struct Allocation {
    void *pointer;
    template<class T> operator T *() const { return static_cast<T *>(pointer); }
};
static Allocation allocate(size_t size, bool zero, void *user = nullptr) {
    void *p = zero ? calloc(1, size) : malloc(size);
    assert(p && size); allocations.insert(p);
    if (user) memcpy(user, &p, sizeof(p));
    return {p};
}
static Allocation reallocate(void *old, size_t size, void *user) {
    if (old) { assert(allocations.erase(old) == 1); }
    void *p = realloc(old, size); assert(p); allocations.insert(p);
    if (user) memcpy(user, &p, sizeof(p));
    return {p};
}
static void release(void *p) { if (p) { assert(allocations.erase(p) == 1); free(p); } }
#undef Z_Malloc
#undef Z_Calloc
#undef Z_Realloc
#undef Z_Free
#define Z_Malloc(s,t,u) allocate(s, false, u)
#define Z_Calloc(s,t,u) allocate(s, true, u)
#define Z_Realloc(p,s,t,u) reallocate(p, s, u)
#define Z_Free(p) release(p)
void I_Error(const char *, ...) { abort(); }
precise_t I_GetPreciseTime() { static precise_t clock; return ++clock; }
boolean R_UsingFrameInterpolation() { return false; }
void R_InterpolateMobjState(mobj_t *mo, fixed_t, interpmobjstate_t *out) { out->z = mo->z; }
void R_InterpolatePrecipMobjState(precipmobj_t *mo, fixed_t, interpmobjstate_t *out) { out->z = mo->z; }
boolean R_NoEncore(sector_t *, levelflat_t *, boolean) { return false; }
static gl_vissprite_t *HWR_GetVisSprite(UINT32 n) { assert(n < 64); return &testSprites[n]; }
void HWR_GetLevelFlat(levelflat_t *, boolean) {}
void *M_Memcpy(void *dest, const void *src, size_t size) { return memcpy(dest, src, size); }
GLMapTexture_t *HWR_GetTexture(INT32, INT32) { return nullptr; }
static UINT32 linkdrawcount;
static struct { FOutVector verts[4]; gl_vissprite_t *spr; } linkdrawlist[MAXVISSPRITES];
static int hackFinishes, modelLighting, modelsDrawn, modelAttempts, shadowDraws;
static bool modelSucceeds = true;
static void HWR_LinkDrawHackFinish() { ++hackFinishes; linkdrawcount = 0; }
static std::vector<int> waterStates;
static int waterState;
static void State(hwdspecialstate_t state, INT32 value) {
    if (state == HWD_SET_MODEL_LIGHTING) modelLighting = value;
    if (state == HWD_SET_WATER_SURFACE) { waterStates.push_back(value); waterState=value; }
}
static void Blend(FBITFIELD) {}
static void Transform(FTransform *) {}
static void Shader(INT32) {}
struct Pixel { float r{}, g{}, b{}; };
static Pixel pixel;
static std::vector<int> draws;
static std::vector<Pixel> colors;
static void composite(Pixel &dst, Pixel src, float alpha) {
    dst = {src.r*alpha+dst.r*(1-alpha), src.g*alpha+dst.g*(1-alpha), src.b*alpha+dst.b*(1-alpha)};
}
static void capture(gl_vissprite_t *spr) {
    assert(waterState==0); // Objects cannot continue an earlier water snapshot.
    int id = int(spr - testSprites);
    draws.push_back(id);
    composite(pixel, colors[id], 0.5f);
}
static void HWR_DrawSprite(gl_vissprite_t *spr) { capture(spr); }
static void HWR_DrawBoundingBox(gl_vissprite_t *spr) { draws.push_back(int(spr-testSprites)); }
static void HWR_DrawPrecipitationSprite(gl_vissprite_t *spr) { capture(spr); }
static void HWR_DrawDropShadow(mobj_t *, fixed_t) { ++shadowDraws; }
boolean HWR_DrawModel(gl_vissprite_t *spr) {
    assert(modelLighting); ++modelAttempts;
    if (modelSucceeds) { ++modelsDrawn; capture(spr); }
    return modelSucceeds;
}

