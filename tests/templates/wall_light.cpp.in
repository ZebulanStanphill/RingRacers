#include <algorithm>
#include <array>
#include <cassert>
#include <cmath>
#include <cstdio>
#include <cstring>
#include <vector>
#include "doomdef.h"
#include "hardware/hw_driver.h"
#include "r_defs.h"
#include "p_local.h"
#include "p_slopes.h"
#include "hardware/hw_defs.h"
#include "hardware/hw_glob.h"
#include "r_main.h"
#undef min
#undef max
#define min std::min
#define max std::max
#define M_Memcpy std::memcpy

struct Draw {
    std::array<FOutVector,4> v;
    FBITFIELD flags;
    INT32 light, texture, base;
    extracolormap_t *color;
    UINT8 alpha;
    bool queued, fog;
    // With Software's steps: whether the light was offset (HWR_StepWallLight), and under which sector's lighting model
    bool stepped;
    const sector_t *stepSector;
};
static std::vector<Draw> draws;
// The black fill HWR_SplitWall draws over a solid wall's cut (HWR_DrawCutVoid in hw_main.c) unbinds the wall's
// texture; every textured piece after it must find it bound again (HWR_GetTexture).
static bool textureBound=true;
static int rebinds=0;
GLMapTexture_t *HWR_GetTexture(INT32 tex,INT32 base) { assert(tex==43 && base==44);textureBound=true;++rebinds;return nullptr; }
static seg_t segment{};
static seg_t *gl_curline=&segment;
static int wallLightCalls=0;
static FUINT HWR_CalcWallLight(FUINT light,seg_t *seg) { assert(seg==gl_curline);++wallLightCalls;return light; }
// Whether VibeRant draws with shaders (HWR_SoftwareLightSteps), which HWR_SliceWallLight asks. The offset rule is asked
// about the light number and the sector, and says that it applies, so that the offset (the seg's lightOffset, in eights
// of a light level) is added wherever HWR_StepWallLight is called, and the sector it was asked about is noted.
static bool steps;
static boolean HWR_SoftwareLightSteps(void) { return steps; }
static int offsetAsks;
static const sector_t *offsetAsked;
boolean P_ApplyLightOffset(UINT8,const sector_t *sector) { ++offsetAsks;offsetAsked=sector;return true; }
@@STEP_LIGHT@@
@@SKIPS_OFFSET@@
@@SLICE_LIGHT@@
static void Submit(FOutVector *v,FSurfaceInfo *surf,FBITFIELD flags,INT32 light,
    extracolormap_t *color,bool queued,bool fog,INT32 texture=-1,INT32 base=-1) {
    assert(textureBound);
    Draw d{};std::copy(v,v+4,d.v.begin());d.flags=flags;d.light=light;
    if(fog)assert(wallLightCalls==0 && offsetAsks==0);
    // A piece's light is worked out once, by the path that is on
    assert(steps ? wallLightCalls==0 && offsetAsks<=1 : offsetAsks==0);
    d.stepped=offsetAsks==1;d.stepSector=offsetAsked;offsetAsks=0;offsetAsked=nullptr;
    d.color=color;d.alpha=surf->PolyColor.s.alpha;d.queued=queued;d.fog=fog;
    d.texture=texture;d.base=base;draws.push_back(d);
    // A real draw may modify lighting; the next slice must restore alpha.
    surf->PolyColor.s.alpha=0;
}
static void HWR_ProjectWall(FOutVector *v,FSurfaceInfo *s,FBITFIELD f,INT32 l,extracolormap_t *c) {
    Submit(v,s,f,l,c,false,false);
}
static void HWR_AddTransparentWall(FOutVector *v,FSurfaceInfo *s,INT32 t,INT32 b,
    FBITFIELD f,boolean fog,INT32 l,extracolormap_t *c) { Submit(v,s,f,l,c,true,fog,t,b); }
#ifdef __USE_C_FIXEDMUL__
@@FIXED_MUL@@
#endif
@@SLOPE_HEIGHT@@
@@LIGHT_HEIGHT@@
@@FOF_BOTTOM@@
// The black fill's pieces, recorded; HWR_DrawWallLightSlice clips them to the wall
static boolean hwr_splitvoid, hwr_voidslice;
struct Band { float bottom1, bottom2, top1, top2; };
static std::vector<Band> bands;
static void HWR_DrawCutVoid(const FOutVector *piece) {
    assert(hwr_voidslice && piece[0].x==0 && piece[1].x==1024);
    bands.push_back({piece[0].y,piece[1].y,piece[3].y,piece[2].y});textureBound=false;
}
@@CLIP_SLICE@@
@@SPLIT_WALL@@

using Wall=std::array<FOutVector,4>;
static double Mix(double a,double b,double f) { return a+(b-a)*f; }
static Wall MakeWall(float bottom0,float bottom1,float top0,float top1) {
    Wall w{};
    w[0].x=w[3].x=0;w[1].x=w[2].x=1024;
    w[0].z=w[3].z=20;w[1].z=w[2].z=20;
    w[0].y=bottom0;w[1].y=bottom1;w[2].y=top1;w[3].y=top0;
    w[0].s=w[3].s=-.5f;w[1].s=w[2].s=7.9961f;
    w[3].t=.125f;w[2].t=.25f;
    w[0].t=w[3].t+(top0-bottom0)/1024;
    w[1].t=w[2].t+(top1-bottom1)/1024;
    return w;
}
static double Fraction(const Wall &w,const FOutVector &v) {
    const double dx=w[1].x-w[0].x,dz=w[1].z-w[0].z;
    return ((v.x-w[0].x)*dx+(v.z-w[0].z)*dz)/(dx*dx+dz*dz);
}
static void CheckVertices(const Wall &w,FBITFIELD flags) {
    for(const Draw &d:draws) {
        assert(d.flags==flags && d.alpha==77);
        assert(d.queued==bool(flags&(PF_Fog|PF_EnvironmentTrans)));
        assert(d.fog==bool(flags&PF_Fog));
        if(d.queued)assert(d.texture==43 && d.base==44);
        for(int i=0;i<4;++i) {
            const auto &v=d.v[i];const double f=Fraction(w,v);
            const double top=Mix(w[3].y,w[2].y,f),bottom=Mix(w[0].y,w[1].y,f);
            assert(std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.z));
            assert(std::isfinite(v.s) && std::isfinite(v.t));
            assert(f>=-1e-5 && f<=1+1e-5);
            assert(v.y>=bottom-.002 && v.y<=top+.002);
            assert(std::abs(v.s-Mix(w[0].s,w[1].s,f))<.00001);
            const double t=Mix(w[3].t,w[2].t,f)+(top-v.y)/1024;
            assert(std::abs(v.t-t)<.00001);
        }
        assert(d.v[3].y>=d.v[0].y && d.v[2].y>=d.v[1].y);
        // A piece with no height at either end covers nothing and must not be submitted.
        assert(d.v[3].y>d.v[0].y || d.v[2].y>d.v[1].y);
    }
}
// Sample actual emitted polygons, checking exact area coverage and lighting.
// Test points are offset from boundaries so sharing an edge is not double coverage.
static void CheckCoverage(const Wall &w,double boundary0,double boundary1,
    INT32 lightAbove=224,INT32 lightBelow=128,double holeTop=-1e20,double holeBottom=-1e20) {
    for(int column=0;column<159;++column) {
        const double f=(column+.371)/159;
        const double top=Mix(w[3].y,w[2].y,f),bottom=Mix(w[0].y,w[1].y,f);
        for(int row=-3;row<44;++row) {
            const double y=Mix(bottom,top,(row+.217)/41);
            int hits=0;
            for(const Draw &d:draws) {
                const double a=Fraction(w,d.v[0]),b=Fraction(w,d.v[1]);
                if(f<=a || f>=b)continue;
                const double local=(f-a)/(b-a);
                const double hi=Mix(d.v[3].y,d.v[2].y,local),lo=Mix(d.v[0].y,d.v[1].y,local);
                if(y>lo && y<hi) {
                    ++hits;
                    assert(d.light==(y>Mix(boundary0,boundary1,f)?lightAbove:lightBelow));
                }
            }
            const bool inWall=y>bottom && y<top;
            const bool inHole=y>holeBottom && y<holeTop;
            assert(hits==int(inWall && !inHole));
        }
    }
}
static INT16 levels[2]={224,128};
static extracolormap_t colors[2]{};
static extracolormap_t *colorPtrs[2]={&colors[0],&colors[1]};
static int cases;
static void Run(Wall w,float boundary0,float boundary1,FBITFIELD flags=PF_Masked,bool noShade=false) {
    draws.clear();wallLightCalls=0;FSurfaceInfo surf{};surf.PolyColor.s.alpha=77;
    lightlist_t lights[2]{};sector_t sector{};sector.lightlevel=224;
    sector.numlights=2;sector.lightlist=lights;
    pslope_t slope{};slope.o.x=FLOAT_TO_FIXED(w[0].x);slope.o.y=FLOAT_TO_FIXED(w[0].z);
    slope.o.z=FLOAT_TO_FIXED(boundary0);
    const float length=std::hypot(w[1].x-w[0].x,w[1].z-w[0].z);
    // Use the real fixed-point slope evaluation at both endpoints.
    slope.d.x=FLOAT_TO_FIXED((w[1].x-w[0].x)/length);
    slope.d.y=FLOAT_TO_FIXED((w[1].z-w[0].z)/length);
    slope.zdelta=FLOAT_TO_FIXED((boundary1-boundary0)/length);
    lights[0].height=3000*FRACUNIT;lights[1].height=FLOAT_TO_FIXED(boundary0);
    lights[1].slope=boundary0==boundary1?nullptr:&slope;
    for(int i=0;i<2;++i) { lights[i].lightlevel=&levels[i];lights[i].extra_colormap=&colorPtrs[i]; }
    lights[1].flags=FOF_SWIMMABLE|FOF_EXTRA|FOF_CUTEXTRA|(noShade?FOF_NOSHADE:0);
    const Wall original=w;
    HWR_SplitWall(&sector,w.data(),43,44,&surf,FOF_CUTLEVEL,nullptr,flags);
    CheckVertices(original,flags);
    // Evaluate the light plane without P_GetLightZAt or P_GetSlopeZAt: in double precision, from the slope's own
    // fixed-point origin, direction and gradient (so the oracle tests clipping, not the float-to-fixed rounding
    // of the fixture). A flat light uses its own height. The fixture must also describe the intended boundary.
    auto plane=[&](double x,double z) {
        if(!lights[1].slope)return lights[1].height/65536.0;
        const double dist=(x-slope.o.x/65536.0)*(slope.d.x/65536.0)+(z-slope.o.y/65536.0)*(slope.d.y/65536.0);
        return slope.o.z/65536.0+dist*(slope.zdelta/65536.0);
    };
    const double b0=plane(original[0].x,original[0].z),b1=plane(original[1].x,original[1].z);
    assert(std::abs(b0-boundary0)<.02 && std::abs(b1-boundary1)<.02);
    CheckCoverage(original,b0,b1,224,noShade?224:128);
    for(const Draw &d:draws)assert(d.color==(d.light==224?colorPtrs[0]:colorPtrs[1]));
    ++cases;
}
static void Existing() {
    // Build 93's second Xbox pixel capture, Water Palace line 1 / WTPTU1.
    // Original 18-unit tier crosses the water light plane at -52. The old
    // splitter emitted left bottom=-52, top=-614, then an expanded lower band.
    Wall palace=MakeWall(-632,-52.01f,-614,-34.01f);
    palace[0].x=palace[3].x=-8736;palace[1].x=palace[2].x=-8736;
    palace[0].z=palace[3].z=-16448;palace[1].z=palace[2].z=-17536;
    palace[3].t=palace[2].t=0;
    palace[0].t=palace[1].t=18.0f/1024;
    Run(palace,-52,-52);
    Run(MakeWall(-682,-682,-634,-634),-52,-52); // first capture: ordinary fence, retained
    for(FBITFIELD f:{PF_Masked,PF_EnvironmentTrans,PF_Fog}) {
        Run(MakeWall(-632,-52,-614,-34),-52,-52,f);
        Run(MakeWall(-52,-632,-34,-614),-52,-52,f);
        Run(MakeWall(-20,-20,20,20),0,0,f);
        Run(MakeWall(-20,-20,20,20),30,30,f); // entirely below boundary
        Run(MakeWall(-20,-20,20,20),-30,-30,f); // entirely above boundary
        Run(MakeWall(-20,-20,20,20),-40,40,f); // light plane crosses both edges
        Run(MakeWall(-20,20,20,40),30,-30,f);
        Run(MakeWall(-20,-40,20,-20),-30,30,f);
        Run(MakeWall(0,0,0,20),0,0,f); // zero-height left endpoint
        Run(MakeWall(0,0,20,0),10,10,f); // zero-height right endpoint
        Run(MakeWall(-20,50,20,40),0,0,f); // original tier closes inside the span
        Run(MakeWall(0,0,0,0),0,0,f); // no geometry, no division by zero
        assert(draws.empty());
        Run(MakeWall(-20,-20,20,20),0,0,f,true);
    }
    // Seeded sloped walls/boundaries: independent polygon coverage oracle.
    unsigned seed=0x57a11;
    auto next=[&]() { seed=1664525u*seed+1013904223u;return float(int((seed>>16)%201)-100); };
    for(int i=0;i<100;++i) {
        const float b0=next(),b1=next(),h0=1+std::abs(next()),h1=1+std::abs(next());
        const float l0=next(),l1=next();
        Run(MakeWall(b0,b1,b0+h0,b1+h1),l0,l1);
    }
    // Solid FOF excludes its interior while retaining the actual wall above/below.
    for(INT32 cut:{INT32(FOF_CUTLEVEL),INT32(FOF_EXTRA|FOF_SWIMMABLE),INT32(FOF_EXTRA|FOF_FOG)}) {
        Wall w=MakeWall(-20,-20,20,20),original=w;draws.clear();
        FSurfaceInfo surf{};surf.PolyColor.s.alpha=77;
        fixed_t bottom=-10*FRACUNIT;pslope_t *noSlope=nullptr;
        ffloor_t solid{};solid.bottomheight=&bottom;solid.b_slope=&noSlope;
        lightlist_t lights[3]{};sector_t sector{};sector.lightlevel=224;
        sector.numlights=3;sector.lightlist=lights;
        lights[0].height=100*FRACUNIT;lights[1].height=10*FRACUNIT;
        lights[2].height=-10*FRACUNIT;
        lights[1].flags=(cut==INT32(FOF_CUTLEVEL)?FOF_CUTSOLIDS:FOF_CUTEXTRA|FOF_EXTRA|FOF_SWIMMABLE);
        lights[1].caster=&solid;
        for(int i=0;i<3;++i) { lights[i].lightlevel=&levels[0];lights[i].extra_colormap=&colorPtrs[0]; }
        const bool cuts=cut!=INT32(FOF_EXTRA|FOF_FOG);
        for(bool solidWall:{false,true}) {
            Wall copy=original;draws.clear();bands.clear();rebinds=0;surf.PolyColor.s.alpha=77;hwr_splitvoid=solidWall;
            HWR_SplitWall(&sector,copy.data(),43,44,&surf,cut,nullptr,PF_Masked);
            hwr_splitvoid=false;
            CheckVertices(original,PF_Masked);
            CheckCoverage(original,0,0,224,224,cuts?10:-1e20,cuts?-10:-1e20);++cases;
            // Only a solid wall's cut is filled, exactly the part left out: the 3D floor's bottom up to its top.
            if(solidWall && cuts) {
                assert(bands.size()==1);
                assert(bands[0].bottom1==-10 && bands[0].bottom2==-10 && bands[0].top1==10 && bands[0].top2==10);
                assert(rebinds==1);
            } else assert(bands.empty() && rebinds==0);
        }
    }
    // Two solid 3D floors, the first reaching below the wall: the second's cut lies wholly below the wall, which
    // the first already took the rest of. Nothing may be filled outside the wall.
    {
        Wall w=MakeWall(-20,-20,20,20);draws.clear();bands.clear();rebinds=0;
        FSurfaceInfo surf{};surf.PolyColor.s.alpha=77;
        fixed_t bottomA=-30*FRACUNIT,bottomB=-60*FRACUNIT;pslope_t *noSlope=nullptr;
        ffloor_t solidA{},solidB{};solidA.bottomheight=&bottomA;solidA.b_slope=&noSlope;
        solidB.bottomheight=&bottomB;solidB.b_slope=&noSlope;
        lightlist_t lights[3]{};sector_t sector{};sector.lightlevel=224;
        sector.numlights=3;sector.lightlist=lights;
        lights[0].height=100*FRACUNIT;lights[1].height=10*FRACUNIT;lights[2].height=-40*FRACUNIT;
        lights[1].flags=lights[2].flags=FOF_CUTSOLIDS;lights[1].caster=&solidA;lights[2].caster=&solidB;
        for(int i=0;i<3;++i) { lights[i].lightlevel=&levels[0];lights[i].extra_colormap=&colorPtrs[0]; }
        hwr_splitvoid=true;
        HWR_SplitWall(&sector,w.data(),43,44,&surf,FOF_CUTLEVEL,nullptr,PF_Masked);
        hwr_splitvoid=false;
        assert(bands.size()==1);
        assert(bands[0].bottom1==-20 && bands[0].bottom2==-20 && bands[0].top1==10 && bands[0].top2==10);
        for(const Draw &d:draws) for(const FOutVector &v:d.v) assert(v.y>=10-.002);
        ++cases;
    }
    // A solid 3D floor reaching below the wall: the fill stops at the wall's bottom, where the wall itself ends.
    {
        Wall w=MakeWall(-20,-20,20,20);draws.clear();bands.clear();
        FSurfaceInfo surf{};surf.PolyColor.s.alpha=77;
        fixed_t bottom=-50*FRACUNIT;pslope_t *noSlope=nullptr;
        ffloor_t solid{};solid.bottomheight=&bottom;solid.b_slope=&noSlope;
        lightlist_t lights[2]{};sector_t sector{};sector.lightlevel=224;
        sector.numlights=2;sector.lightlist=lights;
        lights[0].height=100*FRACUNIT;lights[1].height=10*FRACUNIT;
        lights[1].flags=FOF_CUTSOLIDS;lights[1].caster=&solid;
        for(int i=0;i<2;++i) { lights[i].lightlevel=&levels[0];lights[i].extra_colormap=&colorPtrs[0]; }
        hwr_splitvoid=true;
        HWR_SplitWall(&sector,w.data(),43,44,&surf,FOF_CUTLEVEL,nullptr,PF_Masked);
        hwr_splitvoid=false;
        assert(bands.size()==1);
        assert(bands[0].bottom1==-20 && bands[0].bottom2==-20 && bands[0].top1==10 && bands[0].top2==10);
        for(const Draw &d:draws) for(const FOutVector &v:d.v) assert(v.y>=10-.002);
        ++cases;
    }
    // A light boundary exactly at the wall's bottom, with another light further below: nothing remains of the
    // wall below the first boundary, which must not be submitted as a zero-height piece.
    for(FBITFIELD f:{PF_Masked,PF_EnvironmentTrans,PF_Fog}) {
        Wall w=MakeWall(-20,-20,20,20),original=w;draws.clear();wallLightCalls=0;
        FSurfaceInfo surf{};surf.PolyColor.s.alpha=77;
        lightlist_t lights[3]{};sector_t sector{};sector.lightlevel=224;
        sector.numlights=3;sector.lightlist=lights;
        lights[0].height=3000*FRACUNIT;lights[1].height=-20*FRACUNIT;lights[2].height=-40*FRACUNIT;
        for(int i=0;i<3;++i) { lights[i].lightlevel=&levels[i?1:0];lights[i].extra_colormap=&colorPtrs[i?1:0]; }
        HWR_SplitWall(&sector,w.data(),43,44,&surf,FOF_CUTLEVEL,nullptr,f);
        CheckVertices(original,f);
        CheckCoverage(original,-20,-20,224,128);
        assert(draws.size()==1);++cases;
    }
}

// Which sector each piece of a wall is lit under, with Software's steps (HWR_SplitWall's offsetsector, HWR_SliceWallLight):
// the sector HWR_SplitWall was given, or none where Software gives the wall no offset. The seg's coarse offset is 1
// (eight levels), its front sector is another one than the sector the light list is of, and the stub rule says an
// offset always applies, so that a piece's light is its level and eight where there is an offset.
enum Kind { Solid, MidMasked, MidTranslucent, Side, FogSide };
static const char *const kKindNames[] = {"solid wall", "middle masked", "middle translucent", "3D floor side", "fog 3D floor side"};
struct LightSpec { INT16 level; extracolormap_t *map; INT32 flags; };
static int sectorPieces;
static void SectorCheck(Kind kind, bool stepsOn, FBITFIELD polyflags, const std::vector<LightSpec> &specs)
{
    steps=stepsOn;
    draws.clear();wallLightCalls=0;offsetAsks=0;offsetAsked=nullptr;
    // Light heights 3000 (the top), 0, -10, -15, ..: the wall (-20 to 20) is cut in as many bands as there are lights
    sector_t listSector{},frontSector{};seg_t seg{};seg.frontsector=&frontSector;seg.lightOffset=1;
    gl_curline=&seg;
    const size_t count=specs.size();
    std::vector<lightlist_t> lights(count);
    std::vector<INT16> levels(count);
    std::vector<extracolormap_t *> maps(count);
    const float edges[]={20,0,-10,-15};
    assert(count<=3);
    for(size_t i=0;i<count;++i) {
        levels[i]=specs[i].level;maps[i]=specs[i].map;
        lights[i].height=(i?(int)edges[i]:3000)*FRACUNIT;
        lights[i].flags=specs[i].flags;lights[i].lightlevel=&levels[i];lights[i].extra_colormap=&maps[i];
    }
    listSector.lightlevel=250;listSector.numlights=(INT32)count;listSector.lightlist=lights.data();
    // A fog 3D floor's side is lit with the light of its control sector, and the colormap of that sector
    static extracolormap_t masterMap;masterMap=extracolormap_t{};
    sector_t master{};line_t masterLine{};ffloor_t floor{};
    master.lightlevel=77;master.extra_colormap=&masterMap;masterLine.frontsector=&master;floor.master=&masterLine;
    FSurfaceInfo surf{};surf.PolyColor.s.alpha=77;
    Wall w=MakeWall(-20,-20,20,20);const Wall original=w;
    ffloor_t *pfloor=(kind==Side||kind==FogSide)?&floor:nullptr;
    INT32 cut=kind==MidTranslucent?FOF_TRANSLUCENT:FOF_CUTLEVEL;
    if(kind==FogSide){floor.fofflags=static_cast<ffloortype_e>(FOF_FOG);cut=FOF_FOG|FOF_EXTRA|FOF_SWIMMABLE;}
    else if(kind==Side){floor.fofflags=static_cast<ffloortype_e>(FOF_EXISTS|FOF_RENDERALL);cut=floor.fofflags;}
    hwr_splitvoid=kind==Solid;
    HWR_SplitWall(&listSector,w.data(),43,44,&surf,cut,pfloor,polyflags);
    hwr_splitvoid=false;
    CheckVertices(original,polyflags);

    // What each band is expected to get: the state of the last light that is not NOSHADE, from the top of the wall down
    const bool fogPieces=polyflags&PF_Fog;
    INT16 level=250;extracolormap_t *map=nullptr;bool skips=false;
    for(size_t i=0;i<count;++i) {
        if(!(specs[i].flags&FOF_NOSHADE)) {
            if(kind==FogSide){level=77;map=&masterMap;}
            else {
                level=specs[i].level;map=specs[i].map;
                // The translucent middle texture is lit at full brightness, where the colormap isn't fog
                if(kind==MidTranslucent && !(specs[i].flags&FOF_FOG))level=(map&&(map->flags&CMF_FOG))?level:255;
            }
            // Software's rule, written out again from R_RenderMaskedSegRange, R_RenderSegLoop, and R_RenderThickSideRange
            const bool fogMap=map&&(map->flags&CMF_FOG);
            if(kind==Solid)skips=map!=nullptr;
            else if(kind==MidMasked||kind==MidTranslucent)skips=fogMap;
            else skips=kind==FogSide||(specs[i].flags&FOF_FOG)||fogMap;
        }
        // The band's piece: its middle is between this light's height and the next's
        const float top=i?edges[i]:20,bottom=(i+1<count)?edges[i+1]:-20;
        const Draw *piece=nullptr;
        for(const Draw &d:draws) {
            const float mid=(d.v[0].y+d.v[3].y+d.v[1].y+d.v[2].y)/4;
            if(mid<top && mid>bottom){assert(!piece);piece=&d;}
        }
        assert(piece);
        int expected=level;
        if(stepsOn && !fogPieces && !skips)expected=min(255,level+8);
        if(piece->light!=expected || piece->color!=map || piece->stepped!=(stepsOn && !fogPieces && !skips)
            || (piece->stepped && piece->stepSector!=&listSector)) {
            std::fprintf(stderr,"%s, steps %d, polyflags %x, light %zu: light %d expected %d, stepped %d (sector %p, the list's %p)\n",
                kKindNames[kind],stepsOn,(unsigned)polyflags,i,piece->light,expected,piece->stepped,(const void *)piece->stepSector,(const void *)&listSector);
        }
        assert(piece->light==expected && piece->color==map);
        assert(piece->stepped==(stepsOn && !fogPieces && !skips));
        // The sector is the one HWR_SplitWall was given, never the seg's front sector
        if(piece->stepped)assert(piece->stepSector==&listSector && piece->stepSector!=seg.frontsector);
        ++sectorPieces;
    }
    assert(draws.size()==count);
    // Without Software's steps the light is HWR_CalcWallLight's, which takes the seg, and is asked for every piece but fog's
    assert(wallLightCalls==((stepsOn||fogPieces)?0:(int)count));
    ++cases;
}
static void OffsetSectors()
{
    extracolormap_t plain{},fog{};fog.flags=CMF_FOG;
    extracolormap_t *const maps[]={nullptr,&plain,&fog};
    const INT32 lightFlags[]={0,FOF_FOG};
    for(bool stepsOn:{false,true}) for(Kind kind:{Solid,MidMasked,MidTranslucent,Side,FogSide}) {
        // The polygon flags of what is queued or not, and with the fog's own
        std::vector<FBITFIELD> flagSets={PF_Masked,PF_EnvironmentTrans};
        if(kind==FogSide)flagSets.push_back(PF_Fog);
        for(FBITFIELD pf:flagSets)
            for(extracolormap_t *a:maps) for(extracolormap_t *b:maps) for(INT32 fa:lightFlags) for(INT32 fb:lightFlags) {
                // Two lights: each one's colormap and flags decide for its own piece
                SectorCheck(kind,stepsOn,pf,{{200,a,fa},{100,b,fb}});
                // A third that is NOSHADE keeps the one above it, whatever its own colormap or flags
                SectorCheck(kind,stepsOn,pf,{{200,a,fa},{100,b,fb|FOF_NOSHADE},{60,maps[2],0}});
                SectorCheck(kind,stepsOn,pf,{{200,a,fa},{100,maps[2],FOF_NOSHADE|FOF_FOG},{60,b,fb}});
            }
    }
    steps=false;
    gl_curline=&segment;
}
int main() {
    for(bool stepsOn:{false,true}) { steps=stepsOn;Existing(); }
    steps=false;
    OffsetSectors();
    printf("%d wall light fixtures: clipped geometry, texture UVs, exact coverage, lighting, solid holes and their black fill, queued modes, and the sector each piece's offset is judged by (%d pieces)\n",cases,sectorPieces);
}
