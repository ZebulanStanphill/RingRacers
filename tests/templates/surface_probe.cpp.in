#include <cassert>
#include <cstdarg>
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <string>
#include <vector>
#include "doomdef.h"
#include "doomstat.h"
bool g_probePending=false;
INT32 g_probePercentX=0,g_probePercentY=0;
std::vector<std::string> messages;
boolean D3D12_RequestSurfaceProbe(INT32 x,INT32 y) {
    assert(!g_probePending);g_probePending=true;g_probePercentX=x;g_probePercentY=y;return true;
}
std::vector<std::string> args;
size_t COM_Argc(){return (int)args.size();}
const char *COM_Argv(int i){return args.at(i).c_str();}
void CONS_Printf(const char *format,...) {
    char b[512];va_list a;va_start(a,format);vsnprintf(b,sizeof b,format,a);va_end(a);messages.emplace_back(b);
}
constexpr int render_opengl=1;
int rendermode=render_opengl,r_splitscreen=0;
gamestate_t gamestate=GS_LEVEL;
struct {int value=0;} cv_glbatching;
@@COMMAND@@
bool has(const std::string &s) { for(const auto &m:messages)if(m.find(s)!=std::string::npos)return true;return false; }
int main() {
    for(const char *bad:{"", "abc", "10.5", "-1", "101", "999999999999999999999999"}) {
        args={"gr_surfaceprobe",bad,"35"};HWR_SurfaceProbe_f();assert(!g_probePending);
    }
    args={"gr_surfaceprobe","15"};HWR_SurfaceProbe_f();assert(!g_probePending);
    args={"gr_surfaceprobe"};
    cv_glbatching.value=1;HWR_SurfaceProbe_f();assert(!g_probePending&&has("Turn Batching Off first"));
    cv_glbatching.value=0;r_splitscreen=1;HWR_SurfaceProbe_f();assert(!g_probePending);r_splitscreen=0;
    gamestate=GS_NULL;HWR_SurfaceProbe_f();assert(!g_probePending);gamestate=GS_LEVEL;
    rendermode=0;HWR_SurfaceProbe_f();assert(!g_probePending);rendermode=render_opengl;
    HWR_SurfaceProbe_f();assert(g_probePending&&g_probePercentX==15&&g_probePercentY==35);
    g_probePending=false;args={"gr_surfaceprobe","25","75"};HWR_SurfaceProbe_f();
    assert(g_probePending&&g_probePercentX==25&&g_probePercentY==75);
    puts("Surface probe command validation passed");
}
