using Quad=std::array<FOutVector,4>;
struct Draw { std::vector<FOutVector> v; FBITFIELD flags; INT32 shader; FSurfaceInfo surf; };
static std::vector<Draw> draws;
void HWR_ProcessPolygon(FSurfaceInfo *s,FOutVector *v,FUINT n,FBITFIELD flags,int shader,boolean horizon) {
    assert(!horizon);assert(n==3||n==4);draws.push_back({{v,v+n},flags,shader,*s});
}
struct Allocation { void *ptr; void *user; };
static std::vector<Allocation> allocations;
static int reallocations;
void *Z_Realloc2(void *ptr,size_t size,INT32 tag,void *user,INT32 align,const char *,INT32) {
    assert(tag==PU_LEVEL&&user&&align==sizeof(void*));++reallocations;
    auto it=std::find_if(allocations.begin(),allocations.end(),[&](const Allocation &a){return a.user==user;});
    if(it!=allocations.end())assert(it->ptr==ptr);else assert(!ptr);
    void *p=std::realloc(ptr,size);assert(p);std::memcpy(user,&p,sizeof p);
    if(it==allocations.end())allocations.push_back({p,user});else it->ptr=p;
    return p;
}
static void PurgeLevel() {
    for(auto &a:allocations){std::free(a.ptr);void *p=nullptr;std::memcpy(a.user,&p,sizeof p);}allocations.clear();
}
float gl_viewcos=1,gl_viewsin=0;
static float gl_viewx=0,gl_viewy=0,gl_viewz=0;
#include <cstdarg>
static int probeLines;
void I_OutputMsg(const char *fmt,...){++probeLines;va_list ap;va_start(ap,fmt);std::vprintf(fmt,ap);va_end(ap);}
