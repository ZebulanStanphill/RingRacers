// The sprite's own heights, as HWR_ProjectSprite sets them from the patch: the fixture's span unless a case sets them.
static float stubGz=NAN,stubGzt=NAN;
static void HWR_SpriteVertices(gl_vissprite_t *s,FOutVector *v){++vertexCalls;std::copy(fixture.begin(),fixture.end(),v);
    auto [lo,hi]=std::minmax_element(fixture.begin(),fixture.end(),[](const FOutVector &a,const FOutVector &b){return a.y<b.y;});
    s->gz=std::isnan(stubGz)?lo->y:stubGz;s->gzt=std::isnan(stubGzt)?hi->y:stubGzt;}
static void HWR_SplitSprite(gl_vissprite_t *) { ++splitCalls; }
