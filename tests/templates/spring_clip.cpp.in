static std::vector<FOutVector> Corners(const float *c,size_t n){
    std::vector<FOutVector> poly(n);
    for(size_t i=0;i<n;++i)poly[i]={c[3*i],c[3*i+1],c[3*i+2],0,0};
    return poly;
}
static void Overrun(){
    auto f=Solid();
    Begin();hwr_springpeakpieces=0;
    auto first=Corners(scenePlane0,29),second=Corners(scenePlane1,32),side=Corners(sceneSide,4);
    HWR_AddSpringPlane(first.data(),(INT32)first.size(),&f);
    HWR_AddSpringPlane(second.data(),(INT32)second.size(),&f);
    HWR_AddSpringWall(side.data(),&f);
    assert(hwr_numspringwalls==3);
    SetView(-0x1.e1846p+5f,-0x1.f9f1f8p+10f,0x1.934fc8p+8f,0x1.e9d49cp-1f,-0x1.2a0f94p-2f,
        0x1.53309p+6f,-0x1.0d9358p+11f,0x1.782a86p+8f,0x1p+5f);
    DrawChecked();
    assert(!draws.empty()); // Some of the spring is left, whether or not a triangle was kept whole.
    ResetView();PurgeLevel();
}

// SplitMix64 and its own mapping to numbers, so that the sweep sees the same views on every standard library
// (std::uniform_real_distribution and std::uniform_int_distribution differ between them).
struct SplitMix {
    uint64_t state;
    uint64_t Next(){uint64_t z=(state+=0x9E3779B97F4A7C15ull);z=(z^(z>>30))*0xBF58476D1CE4E5B9ull;z=(z^(z>>27))*0x94D049BB133111EBull;return z^(z>>31);}
    double U(double a,double b){return a+(b-a)*(double)(Next()>>11)*0x1p-53;}
    int I(int a,int b){return a+(int)(Next()%(uint64_t)(b-a+1));}
};
// Springs among planes of three or four corners whose first edge is split into twenty to twenty-nine collinear ones
// (a subsector polygon's long edge), and sides, at random cameras. Every view must finish within the buffers.
static void Sweep(int views){
    SplitMix r{2};auto f=Solid();size_t drawn=0;
    for(int it=0;it<views;++it){
        Begin();hwr_springpeakpieces=0;
        float ox=(float)r.U(-4000,4000),oy=(float)r.U(-4000,4000),oz=(float)r.U(-200,600),half=r.I(0,1)?8.f:32.f;
        double dist=r.U(20,600),dir=r.U(0,2*M_PI),ang=dir+M_PI+r.U(-0.7,0.7);
        SetView((float)(ox+dist*std::cos(dir)),(float)(oy+dist*std::sin(dir)),(float)(oz+r.U(-150,250)),(float)std::cos(ang),(float)std::sin(ang),ox,oy,oz,half);
        int occluders=r.I(1,40);
        for(int k=0;k<occluders;++k){
            // Somewhere between the camera and a bit past the spring.
            double t=r.U(-0.2,1.1),cx=ox+(gl_viewx-ox)*t+r.U(-80,80),cy=oy+(gl_viewy-oy)*t+r.U(-80,80);
            if(r.I(0,2)){
                int corners=r.I(3,4);double radius=r.U(4,200),rot=r.U(0,2*M_PI);
                std::vector<std::array<double,2>> base;
                for(int c=0;c<corners;++c){double an=rot+2*M_PI*c/corners;base.push_back({cx+radius*std::cos(an),cy+radius*std::sin(an)});}
                double pa=r.I(0,1)?r.U(-0.6,0.6):0,pb=r.I(0,1)?r.U(-0.6,0.6):0,pc=oz+r.U(-60,60);
                std::vector<FOutVector> poly;
                for(int c=0;c<corners&&(int)poly.size()<HWR_SPRINGMAXVERTS;++c){
                    auto p=base[c],q=base[(c+1)%corners];int sub=c==0?r.I(20,29):0;
                    for(int s=0;s<=sub&&(int)poly.size()<HWR_SPRINGMAXVERTS;++s){
                        double u=(double)s/(sub+1);float x=(float)(p[0]+(q[0]-p[0])*u),z=(float)(p[1]+(q[1]-p[1])*u);
                        poly.push_back({x,(float)(pa*x+pb*z+pc-pa*cx-pb*cy),z,0,0});
                    }
                }
                HWR_AddSpringPlane(poly.data(),(INT32)poly.size(),&f);
            }else{
                double an=r.U(0,2*M_PI),len=r.U(2,200);float b0=(float)(oz+r.U(-80,40)),t0=(float)(b0+r.U(-10,200));
                float b1=r.I(0,1)?b0:(float)(oz+r.U(-80,40)),t1=r.I(0,1)?t0:(float)(b1+r.U(-10,200));
                auto w=Wall((float)cx,(float)cy,(float)(cx+len*std::cos(an)),(float)(cy+len*std::sin(an)),b0,b1,t0,t1);
                HWR_AddSpringWall(w.data(),r.I(0,2)?&f:nullptr);
            }
        }
        DrawChecked();drawn+=draws.size();
        ResetView();PurgeLevel();
    }
    assert(drawn);
}
int main(int argc,char **argv){
    if(argc>1&&std::string(argv[1])=="--metropolis"){int f=Metropolis(true);PurgeLevel();return f?1:0;}
    if(argc>1&&std::string(argv[1])=="--negative-bound")return NegativeBound();
    if(argc>1)return Negative(argv[1]);
    RunCases();ObliqueCamera();Routes();Retention();assert(Metropolis(false)==0);PurgeLevel();Planes();Painter();Slivers();PurgeLevel();Bounds();Overrun();Sweep(3000);
    std::puts("spring silhouette geometry, ordering, interpolation and lifetime passed");return 0;
}
