#include <cassert>
#include <vector>
#include "doomdef.h"
#include "r_defs.h"

// Production forms a node pointer before testing the subsector bit. Keep that
// pointer within allocated storage even for encoded leaf indices.
static node_t storage[NF_SUBSECTOR + 4];
static node_t *nodes = storage;
static fixed_t dup_viewx, dup_viewy;
static unsigned ps_numbspcalls;
static fixed_t *hwbbox;
static int frontSide;
static std::vector<int> visits;
static std::vector<fixed_t *> boxes;
static std::vector<fixed_t *> portalChecks;
static INT32 R_PointOnSide(fixed_t, fixed_t, node_t *) { return frontSide; }
static bool HWR_CheckBBox(fixed_t *box) { return box[0] != 0; }
static bool HWR_PortalBBox(fixed_t *box)
{
    portalChecks.push_back(box);
    return box[1] != 0;
}
static void HWR_Subsector(INT32 leaf)
{
    visits.push_back(leaf);
    boxes.push_back(hwbbox);
}
@@BSP_WALK@@

int main()
{
    // Root front is an internal node with two leaves; root back is leaf 2.
    // Repeat with the viewer on either side to exercise both box slots.
    for (frontSide = 0; frontSide < 2; ++frontSide)
    {
        node_t &root = nodes[0], &branch = nodes[1];
        root.children[frontSide] = 1;
        root.children[frontSide ^ 1] = NF_SUBSECTOR | 2;
        branch.children[frontSide] = NF_SUBSECTOR;
        branch.children[frontSide ^ 1] = NF_SUBSECTOR | 1;
        for (node_t *node : {&root, &branch})
            for (auto &box : node->bbox)
                box[0] = box[1] = 1;
        const auto run = [&](bool boxPasses, bool portalPasses)
        {
            root.bbox[frontSide][0] = boxPasses;
            root.bbox[frontSide][1] = portalPasses;
            visits.clear(); boxes.clear(); portalChecks.clear();
            ps_numbspcalls = 0;
            hwbbox = nullptr;
            HWR_RenderBSPNode(0);
#ifdef _UWP
            const bool frontVisited = boxPasses && portalPasses;
#else
            const bool frontVisited = true;
#endif
            const std::vector<int> expected = frontVisited
                ? std::vector<int>{0, 1, 2} : std::vector<int>{2};
            assert(visits == expected);
#ifdef _UWP
            // The box test must precede (and short-circuit) the portal test.
            if (!boxPasses)
                for (auto *box : portalChecks)
                    assert(box != root.bbox[frontSide]);
#endif
            assert(ps_numbspcalls == (frontVisited ? 5u : 2u));
            size_t i = 0;
            if (frontVisited)
            {
                assert(boxes[i++] == branch.bbox[frontSide]);
                assert(boxes[i++] == branch.bbox[frontSide ^ 1]);
            }
            assert(boxes[i] == root.bbox[frontSide ^ 1]);
        };
        run(false, true);
        run(true, true);
        run(true, false);
    }
}
